<script>
(function() {
  function initTrinityPopup() {
    var modal = document.getElementById('TrinityPopup');
    if (!modal) return;

    var selectedTxt  = document.getElementById('TrinitySelected');
    var nameField    = document.getElementById('trinity-name');
    var dobField     = document.getElementById('trinity-dob');
    var problemField = document.getElementById('trinity-problem');
    var ansNameField = document.getElementById('trinity-ans-name');
    var ansNameWrapper = document.getElementById('trinity-ans-name-wrapper');
    var addAnsWrapper = document.getElementById('trinity-add-ans-wrapper');
    var addAnsBtn = document.getElementById('trinity-add-ans-btn');
    var removeAnsBtn = document.getElementById('trinity-remove-ans-btn');

    var cancelBtn    = document.getElementById('TrinityCancel');
    var closeBtn     = document.getElementById('TrinityClose');
    var saveBtn      = document.getElementById('TrinitySave');
    var currentOption = null;
    var savedNoteData = null; // Store note data globally

    function openPopupForOption(optionValue) {
      if (optionValue !== '3 Steps - Basic' && 
          optionValue !== '11 Steps - Advance' && 
          optionValue !== '21 Steps - Premium') {
        return;
      }

      currentOption = optionValue;
      selectedTxt.textContent = optionValue;
      
      if (optionValue === '21 Steps - Premium') {
        addAnsWrapper.style.display = 'block';
      } else {
        addAnsWrapper.style.display = 'none';
        ansNameWrapper.style.display = 'none';
        ansNameField.value = '';
      }
      
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      ansNameWrapper.style.display = 'none';
      addAnsWrapper.style.display = 'none';
      ansNameField.value = '';
    }

    document.addEventListener('change', function(e) {
      var target = e.target;
      if (!target.matches('input[type="radio"][data-trinity-option]')) return;
      if (!target.checked) return;

      var optionValue = target.getAttribute('data-trinity-option');
      openPopupForOption(optionValue);
    });

    addAnsBtn.addEventListener('click', function() {
      ansNameWrapper.style.display = 'block';
      addAnsWrapper.style.display = 'none';
      ansNameField.focus();
    });

    removeAnsBtn.addEventListener('click', function() {
      ansNameWrapper.style.display = 'none';
      addAnsWrapper.style.display = 'block';
      ansNameField.value = '';
    });

    cancelBtn.addEventListener('click', closeModal);
    closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function(e) {
      if (e.target === modal || e.target.classList.contains('trinity-modal__overlay')) {
        closeModal();
      }
    });

    saveBtn.addEventListener('click', function() {
      if (!nameField.value || !dobField.value || !problemField.value) {
        alert('Please fill all required fields.');
        return;
      }

      // Format note text
      var noteText = '━━━ TRINITY HEALING DETAILS ━━━\n\n';
      noteText += 'Healing Type: ' + currentOption + '\n';
      noteText += 'Name: ' + nameField.value + '\n';
      noteText += 'Date of Birth: ' + dobField.value + '\n';
      noteText += 'Problem: ' + problemField.value;
      
      if (ansNameField.value) {
        noteText += '\nANS Name: ' + ansNameField.value;
      }

      // Store note data
      savedNoteData = noteText;

      // Try to find and set note field (if exists)
      var noteInput = document.querySelector('textarea[name="note"], input[name="note"], #cart-note');
      if (noteInput) {
        noteInput.value = noteText;
      }

      // Update cart note via AJAX immediately
      updateCartNote(noteText);

      // Clear form
      nameField.value = '';
      dobField.value = '';
      problemField.value = '';
      ansNameField.value = '';
      
      closeModal();
    });

    // Function to update cart note via Shopify API
    function updateCartNote(noteText) {
      fetch('/cart/update.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          note: noteText
        })
      })
      .then(response => response.json())
      .then(data => {
        console.log('Cart note updated successfully:', data);
      })
      .catch(error => {
        console.error('Error updating cart note:', error);
      });
    }

    // Intercept "Add to Cart" to ensure note is saved
    document.addEventListener('submit', function(e) {
      var form = e.target;
      if (form.querySelector('button[name="add"]') && savedNoteData) {
        // Note already saved via AJAX, just ensure it's there
        setTimeout(function() {
          updateCartNote(savedNoteData);
        }, 500);
      }
    });

    // Also handle GoKwik button if present
    var gokwikBtn = document.getElementById('gokwik-buy-now');
    if (gokwikBtn) {
      gokwikBtn.addEventListener('click', function() {
        if (savedNoteData) {
          updateCartNote(savedNoteData);
        }
      });
    }
  }

  if (document.readyState !== 'loading') {
    initTrinityPopup();
  } else {
    document.addEventListener('DOMContentLoaded', initTrinityPopup);
  }
})();
</script>






