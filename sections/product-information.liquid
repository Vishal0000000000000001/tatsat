  display: none;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.product_share-modal.active {
  display: flex;
  opacity: 1;
}

.product_share-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  cursor: pointer;
}

/* Modal Content */
.product_share-content {
  position: relative;
  background: #ffffff;
  border-radius: 8px;
  padding: 30px;
  max-width: 500px;
  width: 90%;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  z-index: 10000;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from {
    transform: translateY(-30px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.product_share-content h3 {
  margin: 0 0 20px 0;
  font-size: 20px;
  font-weight: 600;
  color: #333333;
}

/* Close Button */
.product_share-close {
  position: absolute;
  top: 15px;
  right: 15px;
  width: 32px;
  height: 32px;
  background: transparent;
  border: none;
  font-size: 28px;
  line-height: 1;
  color: #666666;
  cursor: pointer;
  transition: color 0.3s ease;
  padding: 0;
}

.product_share-close:hover {
  color: #333333;
}

/* Copy Link Section */
.product_share-copy {
  margin-bottom: 25px;
}

.product_share-copy label,
.product_share-social label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #666666;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.copy-input-wrapper {
  display: flex;
  gap: 8px;
  align-items: stretch;
}

.copy-input-wrapper input.url_share {
  flex: 1;
  padding: 10px 12px;
  border: 1px solid #d1d1d1;
  border-radius: 4px;
  font-size: 14px;
  color: #666666;
  background: #f9f9f9;
}

.copy-input-wrapper input.url_share:focus {
  outline: none;
  border-color: #333333;
  background: #ffffff;
}

.copy-input-wrapper .copy-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  background: #333333;
  color: #ffffff;
  border: none;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.copy-input-wrapper .copy-btn:hover {
  background: #000000;
  transform: translateY(-1px);
}

.copy-input-wrapper .copy-btn:active {
  transform: translateY(0);
}

.copy-input-wrapper .copy-btn.copied {
  background: #28a745;
}

/* Social Media Section */
.product_share-social {
  padding-top: 20px;
  border-top: 1px solid #e5e5e5;
}

/* Responsive */
@media (max-width: 600px) {
  .product_share-content {
    padding: 25px 20px;
    width: 95%;
  }

  .product_share-content h3 {
    font-size: 18px;
  }

  .copy-input-wrapper {
    flex-direction: column;
  }

  .copy-input-wrapper .copy-btn {
    width: 100%;
    justify-content: center;
  }
}

{% endstylesheet %}

<script>
  // Social Share Popup Toggle
  document.addEventListener('DOMContentLoaded', function() {
    const shareLabel = document.querySelector('.product_share_label');
    const shareContent = document.querySelector('.product_share-content');
    const closeButtons = document.querySelectorAll('.product_share-close');
    const copyButton = document.querySelector('.copy-url-btn');
    const urlInput = document.querySelector('.url_share');

    // Open share popup
    if (shareLabel) {
      shareLabel.addEventListener('click', function() {
        shareContent.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    }

    // Close share popup
    closeButtons.forEach(button => {
      button.addEventListener('click', function() {
        shareContent.classList.remove('active');
        document.body.style.overflow = '';
      });
    });

    // Copy URL to clipboard
    if (copyButton && urlInput) {
      copyButton.addEventListener('click', function() {
        urlInput.select();
        urlInput.setSelectionRange(0, 99999); // For mobile devices

        try {
          navigator.clipboard.writeText(urlInput.value).then(function() {
            copyButton.textContent = 'Copied!';
            copyButton.style.background = '#28a745';
            
            setTimeout(function() {
              copyButton.textContent = 'Copy';
              copyButton.style.background = '';
            }, 2000);
          }).catch(function() {
            // Fallback for older browsers
            document.execCommand('copy');
            copyButton.textContent = 'Copied!';
            
            setTimeout(function() {
              copyButton.textContent = 'Copy';
            }, 2000);
          });
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    }

    // Close on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && shareContent.classList.contains('active')) {
        shareContent.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  });
</script>

