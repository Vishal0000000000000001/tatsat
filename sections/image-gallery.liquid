{% stylesheet %}
  .responsive-sec{
        padding: 40px 15px;
  }

    .responsive-sec-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      max-width: 1400px;
      margin: 0 auto;
    }

      .responsive-column{
              position: relative;
      border-radius: 16px;
      overflow: hidden;
      }
    .h2-heading h2{
      text-align: center;
      color: rgb(206 173 128 / 1.0);
      font-size: 32px;
      font-weight: normal;
      padding-bottom: 30px;
    }

    @media(max-width: 425px){
      .responsive-sec-grid {
          grid-template-columns: repeat(2, 1fr);
      }
       .h2-heading h2 {
      font-size: 26px;
      }
    }
{% endstylesheet %}

