{% schema %}
{
  "name": "Video Series",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "TAT SAT SACRED SERIES"
    },
    {
      "type": "textarea",
      "id": "section_subheading",
      "label": "Section Subheading",
      "default": "Watch the energies come alive — from our origin story to healing rituals and karmic activation."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading Font Size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#444444"
    },
    {
    "type": "select",
    "id": "subheading_font_weight",
    "label": "Subheading Font Weight",
    "options": [
      {
        "value": "normal",
        "label": "Normal"
      },
      {
        "value": "bold",
        "label": "Bold"
      },
      {
        "value": "lighter",
        "label": "Lighter"
      },
      {
        "value": "300",
        "label": "300"
      },
      {
        "value": "400",
        "label": "400"
      },
      {
        "value": "500",
        "label": "500"
      },
      {
        "value": "600",
        "label": "600"
      },
      {
        "value": "700",
        "label": "700"
      }
    ],
    "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (MP4 or YouTube Embed)"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Custom Thumbnail"
        },
        {
          "type": "checkbox",
          "id": "is_youtube",
          "label": "Is YouTube Video",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "no_video",
          "label": "No Video (Show Text Instead)",
          "default": false
        },
        {
          "type": "color",
          "id": "placeholder_bg",
          "label": "Placeholder Background Color",
          "default": "#f5f5f5"
        },
        {
          "type": "color",
          "id": "placeholder_text_color",
          "label": "Placeholder Text Color",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "placeholder_text",
          "label": "Placeholder Text",
          "default": "Coming Soon"
        },
        {
          "type": "url",
          "id": "placeholder_link",
          "label": "Optional Link for Placeholder"
        },
        {
          "type": "color",
          "id": "video_title_color",
          "label": "Video Title Color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "video_subtitle_color",
          "label": "Video Subtitle Color",
          "default": "#444444"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clean Video Series",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="video-series-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;">
  <div class="video-series-header">
    <h2 style="font-size: {{ section.settings.heading_font_size }}px; color: {{ section.settings.heading_color }};">{{ section.settings.section_heading }}</h2>
    <p style="font-size: {{ section.settings.subheading_font_size }}px; color: {{ section.settings.subheading_color }}; font-weight: {{ section.settings.subheading_font_weight }};">{{ section.settings.section_subheading }}</p>
  </div>

  <div class="swiper video-slider">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide video-card">
          {% if block.settings.no_video %}
            {% if block.settings.placeholder_link != blank %}
              <a href="{{ block.settings.placeholder_link }}" class="video-wrapper placeholder" 
                style="background-color: {{ block.settings.placeholder_bg }}; color: {{ block.settings.placeholder_text_color }};">
                <span class="placeholder-text">{{ block.settings.placeholder_text }}</span>
              </a>
            {% else %}
              <div class="video-wrapper placeholder" 
                  style="background-color: {{ block.settings.placeholder_bg }}; color: {{ block.settings.placeholder_text_color }};">
                <span class="placeholder-text">{{ block.settings.placeholder_text }}</span>
              </div>
            {% endif %}
          {% elsif block.settings.video_url != blank %}
            <div class="video-wrapper">
              {% if block.settings.is_youtube %}
                {% assign video_id = block.settings.video_url | split: '/' | last %}
                <iframe 
                  src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&loop=1&playlist={{ video_id }}&enablejsapi=1"
                  width="300" 
                  height="533" 
                  frameborder="0" 
                  allow="autoplay; encrypted-media" 
                  allowfullscreen 
                  style="border-radius: 10px; max-width: 300px;">
                </iframe>
              {% else %}
                <video 
                  autoplay 
                  muted 
                  loop 
                  playsinline 
                  poster="{{ block.settings.thumbnail | image_url: width: 800 }}"
                  style="width: 100%; max-width: 300px; height: auto; border-radius: 10px;">
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              {% endif %}
            </div>
          {% endif %}

          <div class="video-card-text">
            <h3 style="color: {{ block.settings.video_title_color }}">{{ block.settings.title }}</h3>
            <p style="color: {{ block.settings.video_subtitle_color }}">{{ block.settings.subtitle }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-pagination"></div>
  </div>
</section>

<style>
.video-series-section {
  text-align: center;
  padding: 40px 20px;
  background: #fff;
}
.video-series-header h2 {
  font-size: 24px;
  margin-bottom: 10px;
}
.video-series-header p {
  font-size: 14px;
  color: #444;
}
.video-slider {
  margin-top: 30px;
}
.video-card {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 12px;
  padding: 10px;
  transition: transform 0.3s ease;
}
.video-card:hover {
  transform: translateY(-4px);
}
.video-wrapper {
  position: relative;
  width: 100%;
  height: auto;
}
.video-card video,
.video-card iframe {
  width: 100%;
  max-width: 300px;
  border-radius: 10px;
  display: block;
  margin-bottom: 10px;
}
.video-card-text h3 {
  font-size: 16px;
  font-weight: bold;
  margin: 5px 0;
}
.video-card-text p {
  font-size: 13px;
  color: #777;
  margin: 0;
}
.swiper-pagination {
  margin-top: 10px;
  text-align: center;
}
.swiper-pagination-bullet {
  width: 10px;
  height: 10px;
  background: #aaa;
  opacity: 1;
  margin: 0 4px;
  border-radius: 50%;
  transition: background 0.3s;
}
.swiper-pagination-bullet-active {
  background: #000;
}
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    new Swiper(".video-slider", {
      spaceBetween: 20,
      loop: true,
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev"
      },
      breakpoints: {
        480: {
          slidesPerView: 2
        },
        768: {
          slidesPerView: 3
        },
        1024: {
          slidesPerView: 4
        },
        1280: {
          slidesPerView: 6
        }
      }
    });
  });
</script>

{% style %}
.video-card iframe,
.video-card video {
  max-width: 300px !important;
  height: 350px !important;
  border-radius: 10px;
  object-fit: cover;
}

@media (max-width: 768px) {
  .video-card iframe,
  .video-card video {
    max-width: 200px !important;
    height: 350px !important;
    border-radius: 10px;
    object-fit: cover;
    margin: auto;
  }

  .video-wrapper.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-size: 16px;
    height: 350px !important;
    max-width: 200px !important;
    text-align: center;
    text-decoration: none;
    margin: auto;
  }
}

.video-wrapper.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 16px;
  height: 350px !important;
  text-align: center;
  text-decoration: none;
  margin: auto;
}
.video-wrapper.placeholder:hover {
  opacity: 0.9;
}
.video-wrapper .placeholder-text {
  padding: 10px;
  word-break: break-word;
}
{% endstyle %}