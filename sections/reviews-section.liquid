<section class="testimonials-sec">
  <style>
    .testimonials-sec {
      background-color: #cead80;
      padding: 40px 20px;
      text-align: center;
      overflow: hidden;
    }

    .testimonials-sec h2 {
      font-size: 28px;
      font-weight: 700;
      color:white;
      margin-bottom: 40px;
    }

    .testimonials-sec-marquee {
      display: flex;
      width: 200%;
      animation: marqueeLeft 30s linear infinite;
      gap: 25px;
    }

    .testimonials-sec-marquee.reverse {
      animation: marqueeRight 30s linear infinite;
      margin-top: 25px;
    }

    @keyframes marqueeLeft {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @keyframes marqueeRight {
      from { transform: translateX(-50%); }
      to { transform: translateX(0); }
    }

    .testimonials-sec-card {
      background: #fff;
      border-radius: 16px;
      padding: 25px 20px;
      box-shadow: 0 3px 8px rgba(0,0,0,0.08);
      text-align: left;
      flex: 0 0 320px;
    }

    .testimonials-sec-quote {
      font-size: 14px;
      font-style: italic;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .testimonials-sec-profile {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .testimonials-sec-profile img {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      object-fit: cover;
    }

    .testimonials-sec-profile-info h4 {
      margin: 0;
      font-size: 15px;
      font-weight: 700;
    }

    .testimonials-sec-stars {
      color: #ffb400;
      font-size: 14px;
    }

    .testimonials-sec-star {
      vertical-align: -0.125em;
    }

    @media (max-width: 768px) {
      .testimonials-sec-card {
        flex: 0 0 280px;
      }
    }
  </style>

  <h2>{{ section.settings.heading }}</h2>

  <!-- TOP MARQUEE -->
  <div class="testimonials-sec-marquee">
    {% for block in section.blocks %}
      {% if block.settings.row == 'top' %}
        <div class="testimonials-sec-card">
  <p class="testimonials-sec-quote">
    “{{ block.settings.review }}”
  </p>

  <div class="testimonials-sec-profile">
    {% if block.settings.image %}
      <img src="{{ block.settings.image | img_url: '120x120' }}" alt="{{ block.settings.name }}">
    {% endif %}

    <div class="testimonials-sec-profile-info">
      <h4>{{ block.settings.name }}</h4>
      <div class="testimonials-sec-stars">
        {% for i in (1..block.settings.rating) %}
          <svg class="testimonials-sec-star" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

      {% endif %}
    {% endfor %}
  </div>

  <!-- BOTTOM MARQUEE -->
  <div class="testimonials-sec-marquee reverse">
    {% for block in section.blocks %}
      {% if block.settings.row == 'bottom' %}
        <div class="testimonials-sec-card">
  <p class="testimonials-sec-quote">
    “{{ block.settings.review }}”
  </p>

  <div class="testimonials-sec-profile">
    {% if block.settings.image %}
      <img src="{{ block.settings.image | img_url: '120x120' }}" alt="{{ block.settings.name }}">
    {% endif %}

    <div class="testimonials-sec-profile-info">
      <h4>{{ block.settings.name }}</h4>
      <div class="testimonials-sec-stars">
        {% for i in (1..block.settings.rating) %}
          <svg class="testimonials-sec-star" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials Marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Testimonials"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "select",
          "id": "row",
          "label": "Marquee Row",
          "options": [
            { "value": "top", "label": "Top (Left → Right)" },
            { "value": "bottom", "label": "Bottom (Right → Left)" }
          ],
          "default": "top"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Profile Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer Name"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review Text"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Marquee"
    }
  ]
}
{% endschema %}
