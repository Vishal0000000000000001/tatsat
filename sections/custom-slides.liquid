{% comment %}
  Custom Slideshow with Clickable Image Link (No Button)
{% endcomment %}

<section class="custom-slideshow" id="slideshow-{{ section.id }}">
  <div class="slideshow-wrapper">

    <!-- ARROWS -->
    <button class="slide-arrow prev" aria-label="Previous slide">&#10094;</button>
    <button class="slide-arrow next" aria-label="Next slide">&#10095;</button>

    {% for block in section.blocks %}
      <div class="slide {% if forloop.first %}active{% endif %}">

        {% if block.settings.slide_link != blank %}
          <a href="{{ block.settings.slide_link }}" class="slide-link">
        {% endif %}

        <!-- IMAGE WRAPPER -->
        <div class="slide-media">

          {% if block.settings.desktop_image != blank %}
            <img
              class="slide-image desktop"
              src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
              alt="{{ block.settings.heading | escape }}"
            >
          {% endif %}

          {% if block.settings.mobile_image != blank %}
            <img
              class="slide-image mobile"
              src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
              alt="{{ block.settings.heading | escape }}"
            >
          {% endif %}

        </div>

        {% if block.settings.slide_link != blank %}
          </a>
        {% endif %}

        <!-- OPTIONAL CONTENT (ONLY MOBILE VISIBLE LIKE YOUR CODE) -->
        {% if block.settings.heading != blank or block.settings.text != blank %}
          <div class="slide-content">
            {% if block.settings.heading != blank %}
              <h2>{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </div>
        {% endif %}

      </div>
    {% endfor %}
  </div>
</section>

<style>
/* ---------- BASE ---------- */
.custom-slideshow {
  width: 100%;
  position: relative;
  overflow: hidden;
}

.slideshow-wrapper {
  position: relative;
}

.slide {
  display: none;
  position: relative;
}

.slide.active {
  display: block;
}

/* ---------- LINK RESET ---------- */
.slide-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

/* ---------- MEDIA CARD ---------- */
.slide-media {
  background: #ffffff;
  padding: 20px;
  border-radius: 20px;
  overflow: hidden;
}

.slide-media img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 20px;
}

/* ---------- DESKTOP / MOBILE IMAGE ---------- */
.slide-image.mobile {
  display: none;
}

@media (max-width: 768px) {
  .slide-media {
    padding: 0;
    border-radius: 20px;
  }

  .slide-image.desktop {
    display: none;
  }

  .slide-image.mobile {
    display: block;
  }
}

/* ---------- CONTENT ---------- */
.slide-content {
  display: none;
  position: absolute;
  bottom: 0;
  left: 34%;
  transform: translateY(-250%);
  color: #fff;
  max-width: 450px;
}

.slide-content h2 {
  font-size: 42px;
  margin-bottom: 10px;
}

.slide-content p {
  font-size: 16px;
}

@media (max-width: 768px) {
  .slide-content {
    display: block;
  }
}

/* ---------- ARROWS ---------- */
.slide-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  background: rgba(0,0,0,0.55);
  color: #fff;
  border: none;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slide-arrow.prev { left: 20px; }
.slide-arrow.next { right: 20px; }

@media (max-width: 768px) {
  .slide-arrow {
    width: 38px;
    height: 38px;
    font-size: 18px;
  }
}
</style>

<script>
(function () {
  const slider = document.querySelector('#slideshow-{{ section.id }}');
  if (!slider) return;

  const slides = slider.querySelectorAll('.slide');
  const prevBtn = slider.querySelector('.slide-arrow.prev');
  const nextBtn = slider.querySelector('.slide-arrow.next');

  let index = 0;
  let interval;

  function showSlide(i) {
    slides.forEach(slide => slide.classList.remove('active'));
    slides[i].classList.add('active');
  }

  function nextSlide() {
    index = (index + 1) % slides.length;
    showSlide(index);
  }

  function prevSlide() {
    index = (index - 1 + slides.length) % slides.length;
    showSlide(index);
  }

  function startAutoSlide() {
    interval = setInterval(nextSlide, 7000);
  }

  function resetAutoSlide() {
    clearInterval(interval);
    startAutoSlide();
  }

  nextBtn.addEventListener('click', () => {
    nextSlide();
    resetAutoSlide();
  });

  prevBtn.addEventListener('click', () => {
    prevSlide();
    resetAutoSlide();
  });

  startAutoSlide();
})();
</script>

{% schema %}
{
  "name": "Custom Slideshow",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile Image" },
        { "type": "url", "id": "slide_link", "label": "Image Click Link" },
        { "type": "text", "id": "heading", "label": "Heading (Optional)" },
        { "type": "textarea", "id": "text", "label": "Text (Optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slideshow - Image Click"
    }
  ]
}
{% endschema %}
