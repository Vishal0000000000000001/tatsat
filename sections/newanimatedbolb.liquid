{%- liquid
  assign sid = section.id
  assign distance = section.settings.scroll_distance | append: 'vh'
-%}

<section
  id="BlobScroll-{{ sid }}"
  class="blob-scroll"
  style="
    --bs-bg: {{ section.settings.bg_color }};
    --bs-text: {{ section.settings.text_color }};
    --bs-accent: {{ section.settings.accent_color }};
    --bs-distance: {{ distance }};
  "
>
  <div class="blob-scroll__stage">
    {%- liquid
      assign bg_desktop = section.settings.bg_image
      assign bg_mobile = section.settings.bg_image_mobile | default: bg_desktop
      if bg_desktop == blank
        assign bg_desktop = bg_mobile
      endif
    -%}
    {%- if bg_desktop != blank -%}
      <div class="blob-scroll__bg" data-bg>
        <picture>
          <source media="(max-width: 749px)" srcset="{{ bg_mobile | image_url: width: 1000 }}">
          {{ bg_desktop | image_url: width: 2400 | image_tag: loading: 'eager', alt: '' }}
        </picture>
      </div>
    {%- endif -%}

    <div class="blob-scroll__head" data-fade>
      {%- if section.settings.label != blank -%}
        <p class="blob-scroll__label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="blob-scroll__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="blob-scroll__desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="blob-scroll__media" data-media>
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'auto',
            image_size: '1920x'
        }}
      {%- elsif section.settings.video_url != blank -%}
        <video
          src="{{ section.settings.video_url }}"
          {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1920 }}"{% endif %}
          autoplay
          loop
          muted
          playsinline
          preload="auto"
        ></video>
      {%- elsif section.settings.poster != blank -%}
        {{ section.settings.poster | image_url: width: 1920 | image_tag: loading: 'lazy' }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'blob-scroll__placeholder' }}
      {%- endif -%}
    </div>

    {%- if section.settings.tip_text != blank -%}
      <p class="blob-scroll__tip" data-fade>
        {%- if section.settings.tip_label != blank -%}
          <span>{{ section.settings.tip_label }}</span>
        {%- endif -%}
        {{ section.settings.tip_text }}
      </p>
    {%- endif -%}
  </div>
</section>

<style>
  #BlobScroll-{{ sid }} {
    position: relative;
    height: calc(100vh + var(--bs-distance));
    background: var(--bs-bg);
    color: var(--bs-text);
  }

  #BlobScroll-{{ sid }} .blob-scroll__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #BlobScroll-{{ sid }} .blob-scroll__bg {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }

  #BlobScroll-{{ sid }} .blob-scroll__bg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #BlobScroll-{{ sid }} .blob-scroll__head {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1000px;
    padding: 6vh 16px 0;
    text-align: center;
  }

  #BlobScroll-{{ sid }} .blob-scroll__label {
    margin: 0 0 8px;
    color: var(--bs-accent);
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #BlobScroll-{{ sid }} .blob-scroll__heading {
    margin: 0;
    color: var(--bs-text);
    font-size: clamp(40px, 7vw, 110px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  #BlobScroll-{{ sid }} .blob-scroll__desc {
    margin-top: 2.5vh;
    font-size: clamp(12px, 1.1vw, 17px);
    font-weight: 600;
    line-height: 1.15;
    text-transform: uppercase;
  }

  #BlobScroll-{{ sid }} .blob-scroll__desc p { margin: 0; }

  /* Bold / italic text in the description is shown in the accent color */
  #BlobScroll-{{ sid }} .blob-scroll__desc strong,
  #BlobScroll-{{ sid }} .blob-scroll__desc em,
  #BlobScroll-{{ sid }} .blob-scroll__desc a,
  #BlobScroll-{{ sid }} .blob-scroll__tip span {
    color: var(--bs-accent);
    font-style: normal;
    font-weight: inherit;
    text-decoration: none;
  }

  #BlobScroll-{{ sid }} .blob-scroll__media {
    position: absolute;
    z-index: 3;
    inset: 0;
    overflow: hidden;
    clip-path: circle(0px at 50% 58%);
    will-change: clip-path;
  }

  #BlobScroll-{{ sid }} .blob-scroll__media video,
  #BlobScroll-{{ sid }} .blob-scroll__media img,
  #BlobScroll-{{ sid }} .blob-scroll__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  #BlobScroll-{{ sid }} .blob-scroll__tip {
    position: absolute;
    z-index: 2;
    bottom: 4vh;
    left: 0;
    right: 0;
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    text-transform: uppercase;
  }

</style>

<script>
  (function () {
    var section = document.getElementById('BlobScroll-{{ sid }}');
    if (!section || section.dataset.bsInit) return;
    section.dataset.bsInit = '1';

    var MORPH = {{ section.settings.morph | json }};
    var SMOOTH = {{ section.settings.scrub | json }};
    var BLOB = {{ section.settings.blob_size | json }};
    var BLOB_MOBILE = {{ section.settings.blob_size_mobile | json }};

    var stage = section.querySelector('.blob-scroll__stage');
    var media = section.querySelector('[data-media]');
    var fades = section.querySelectorAll('[data-fade]');
    var bg = section.querySelector('[data-bg]');

    var video = media.querySelector('video');
    if (video) {
      video.muted = true;
      var playing = video.play();
      if (playing && playing.catch) playing.catch(function () {});
    }

    // Organic blob: 8 border-radius values that wobble around 50% (a soft circle)
    var base = [50, 50, 50, 50, 50, 50, 50, 50];
    var amp = [8, 7, 9, 6, 7, 9, 6, 8];
    var speed = [0.9, 1.1, 0.7, 1.3, 1.0, 0.8, 1.2, 0.95];
    var phase = [0, 1.3, 2.1, 3.4, 0.7, 2.8, 4.1, 5.0];

    var current = 0;
    var lastTime = performance.now();
    var running = false;

    function targetProgress() {
      var rect = section.getBoundingClientRect();
      var total = section.offsetHeight - stage.offsetHeight;
      if (total <= 0) return 0;
      return Math.min(1, Math.max(0, -rect.top / total));
    }

    function render(p, t) {
      var e = 1 - (1 - p) * (1 - p); // ease-out: grows fast right away
      var vw = stage.clientWidth;
      var vh = stage.clientHeight;
      var size = vw < 750 ? (vw * BLOB_MOBILE) / 100 : (Math.min(vw, vh) * BLOB) / 100;

      var w = size + (vw - size) * e;
      var h = size + (vh - size) * e;
      var cy = vh * 0.58 + (vh / 2 - vh * 0.58) * e;

      var top = Math.max(0, cy - h / 2);
      var bottom = Math.max(0, vh - (cy + h / 2));
      var side = Math.max(0, (vw - w) / 2);

      var k = 1 - e; // shape fades to a rectangle as it grows
      var r = base.map(function (b, i) {
        var wobble = MORPH ? Math.sin(t * speed[i] + phase[i]) * amp[i] : 0;
        return (((b + wobble) * k) / 100 * (i < 4 ? w : h)).toFixed(1) + 'px';
      });

      media.style.clipPath =
        'inset(' + top.toFixed(1) + 'px ' + side.toFixed(1) + 'px ' + bottom.toFixed(1) + 'px ' + side.toFixed(1) + 'px round ' +
        r[0] + ' ' + r[1] + ' ' + r[2] + ' ' + r[3] + ' / ' + r[4] + ' ' + r[5] + ' ' + r[6] + ' ' + r[7] + ')';

      var f = Math.min(1, p / 0.3);
      for (var i = 0; i < fades.length; i++) {
        fades[i].style.opacity = 1 - f;
        fades[i].style.transform = 'translateY(' + -40 * f + 'px)';
      }

      // Background image fades out as the video grows
      if (bg) {
        var b = Math.min(1, p / 0.6);
        bg.style.opacity = 1 - b;
        bg.style.transform = 'scale(' + (1 + 0.1 * b) + ')';
      }
    }

    function tick(now) {
      if (!running) return;
      var dt = Math.min(0.1, (now - lastTime) / 1000);
      lastTime = now;

      var target = targetProgress();
      current = SMOOTH > 0 ? current + (target - current) * (1 - Math.exp(-dt / (SMOOTH / 4))) : target;

      render(current, now / 1000);
      requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      lastTime = performance.now();
      current = targetProgress();
      requestAnimationFrame(tick);
    }

    // Only animate while the section is on screen
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) start();
        else running = false;
      }).observe(section);
    } else {
      start();
    }

    render(targetProgress(), performance.now() / 1000);
  })();
</script>

{% schema %}
{
  "name": "Blob scroll video",
  "tag": "div",
  "class": "section-blob-scroll",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "label", "label": "Small label", "default": "07. Urbanhut film" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A vision in motion." },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Bold or italic words are shown in the accent color.",
      "default": "<p>Experience the essence of <strong>Urbanhut</strong> through film. Our <strong>cinematic</strong> journey brings to life the bold, artistic spirit behind each collection.</p>"
    },
    { "type": "text", "id": "tip_label", "label": "Tip label", "default": "Tip:" },
    { "type": "text", "id": "tip_text", "label": "Tip text", "default": "Scroll to dive" },

    { "type": "header", "content": "Video" },
    { "type": "video", "id": "video", "label": "Video (Shopify upload)" },
    { "type": "url", "id": "video_url", "label": "Or video URL (.mp4)" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },

    { "type": "header", "content": "Background image" },
    {
      "type": "image_picker", "id": "bg_image", "label": "Background image (desktop)",
      "info": "Fades away as the video grows on scroll."
    },
    {
      "type": "image_picker", "id": "bg_image_mobile", "label": "Background image (mobile)",
      "info": "Optional. Uses the desktop image if empty."
    },

    { "type": "header", "content": "Animation" },
    {
      "type": "range", "id": "scroll_distance", "label": "Scroll distance",
      "min": 50, "max": 400, "step": 25, "unit": "vh", "default": 150
    },
    {
      "type": "range", "id": "blob_size", "label": "Blob size (desktop)",
      "min": 20, "max": 70, "step": 1, "unit": "%", "default": 46
    },
    {
      "type": "range", "id": "blob_size_mobile", "label": "Blob size (mobile)",
      "min": 40, "max": 95, "step": 1, "unit": "vw", "default": 78
    },
    {
      "type": "range", "id": "scrub", "label": "Scroll smoothing",
      "min": 0, "max": 1, "step": 0.1, "unit": "s", "default": 0.2,
      "info": "0 = blob follows the scroll exactly. Higher = softer but laggier."
    },
    { "type": "checkbox", "id": "morph", "label": "Wobble blob shape", "default": true },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FDF8F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E2412E" }
  ],
  "presets": [{ "name": "Blob scroll video" }]
}
{% endschema %}
