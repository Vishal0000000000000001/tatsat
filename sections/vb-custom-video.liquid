{%- liquid
  assign sid = section.id
  assign video_desktop = section.settings.video_desktop
  assign video_mobile = section.settings.video_mobile | default: video_desktop

  assign ratio_desktop = video_desktop.aspect_ratio | default: 1.7778
  assign ratio_mobile = video_mobile.aspect_ratio | default: 0.5625

  assign poster_mobile = video_mobile.preview_image
  assign poster_desktop = video_desktop.preview_image
-%}

{%- comment -%} Preload the hero poster so the LCP image is discovered early and painted with high priority {%- endcomment -%}
{%- if poster_mobile != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ poster_mobile | image_url: width: 750 }}"
    media="(max-width: 749px)"
    fetchpriority="high"
  >
{%- endif -%}
{%- if poster_desktop != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ poster_desktop | image_url: width: 1500 }}"
    media="(min-width: 750px)"
    fetchpriority="high"
  >
{%- endif -%}

<div
  id="CustomVideo-{{ sid }}"
  class="custom-video{% unless section.settings.full_width %} custom-video--boxed{% endunless %}"
  style="
    --cv-ratio-desktop: {{ ratio_desktop }};
    --cv-ratio-mobile: {{ ratio_mobile }};
    --cv-height-desktop: {{ section.settings.height_desktop }}px;
    --cv-height-mobile: {{ section.settings.height_mobile }}px;
    --cv-pad-top: {{ section.settings.padding_top }}px;
    --cv-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cv-bg: {{ section.settings.bg_color }};
  "
>
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="custom-video__link" aria-label="{{ section.settings.link_label | default: 'View' | escape }}"></a>
  {%- endif -%}

  {%- if video_desktop == blank and section.settings.video_mobile == blank -%}
    <div class="custom-video__media custom-video__media--desktop custom-video__media--{{ section.settings.size_desktop }} custom-video__placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
    <div class="custom-video__media custom-video__media--mobile custom-video__media--{{ section.settings.size_mobile }} custom-video__placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
  {%- else -%}
    <div class="custom-video__media custom-video__media--desktop custom-video__media--{{ section.settings.size_desktop }}">
      {{
        video_desktop
        | video_tag:
          autoplay: false,
          loop: true,
          controls: false,
          muted: true,
          playsinline: true,
          preload: 'none',
          image_size: '1500x',
          class: 'custom-video__video'
      }}
    </div>
    <div class="custom-video__media custom-video__media--mobile custom-video__media--{{ section.settings.size_mobile }}">
      {{
        video_mobile
        | video_tag:
          autoplay: false,
          loop: true,
          controls: false,
          muted: true,
          playsinline: true,
          preload: 'none',
          image_size: '750x',
          class: 'custom-video__video'
      }}
    </div>

    {%- if section.settings.show_sound_button -%}
      <button
        type="button"
        class="custom-video__sound"
        aria-label="Turn sound off"
        aria-pressed="true"
        data-label-on="Turn sound off"
        data-label-off="Turn sound on"
      >
        <svg class="custom-video__sound-icon custom-video__sound-icon--on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/>
          <path d="M15.5 9a4 4 0 0 1 0 6"/>
          <path d="M18 6.5a7.5 7.5 0 0 1 0 11"/>
        </svg>
        <svg class="custom-video__sound-icon custom-video__sound-icon--off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/>
          <path d="M16 10l4 4M20 10l-4 4"/>
        </svg>
      </button>
    {%- endif -%}
  {%- endif -%}
</div>

<style>
  #CustomVideo-{{ sid }} {
    position: relative;
    width: 100%;
    max-width: 100vw;
    min-width: 0;
    overflow: hidden;
    overflow: clip;
    box-sizing: border-box;
    padding: var(--cv-pad-top) 0 var(--cv-pad-bottom);
    background: var(--cv-bg);
  }

  #CustomVideo-{{ sid }}.custom-video--boxed {
    padding-left: 24px;
    padding-right: 24px;
  }

  #CustomVideo-{{ sid }} .custom-video__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  /* Sound toggle - soft glass button, top right */
  #CustomVideo-{{ sid }} .custom-video__sound {
    position: absolute;
    top: calc(var(--cv-pad-top) + 16px);
    right: 16px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }
  #CustomVideo-{{ sid }} .custom-video__sound:hover {
    opacity: 1;
    background: rgb(0 0 0 / 0.42);
    transform: scale(1.05);
  }
  #CustomVideo-{{ sid }} .custom-video__sound:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  #CustomVideo-{{ sid }}.custom-video--boxed .custom-video__sound { right: 40px; }
  #CustomVideo-{{ sid }} .custom-video__sound-icon--off { display: none; }
  #CustomVideo-{{ sid }} .custom-video__sound.is-muted .custom-video__sound-icon--on { display: none; }
  #CustomVideo-{{ sid }} .custom-video__sound.is-muted .custom-video__sound-icon--off { display: block; }

  #CustomVideo-{{ sid }} .custom-video__media {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  /* Adapt = video's own shape, nothing cropped */
  #CustomVideo-{{ sid }} .custom-video__media--desktop.custom-video__media--adapt { aspect-ratio: var(--cv-ratio-desktop); }
  #CustomVideo-{{ sid }} .custom-video__media--mobile.custom-video__media--adapt { aspect-ratio: var(--cv-ratio-mobile); }

  /* Full screen = fills the visible screen height */
  #CustomVideo-{{ sid }} .custom-video__media--screen { height: 100vh; height: 100svh; }

  /* Custom = fixed height in px */
  #CustomVideo-{{ sid }} .custom-video__media--desktop.custom-video__media--custom { height: var(--cv-height-desktop); }
  #CustomVideo-{{ sid }} .custom-video__media--mobile.custom-video__media--custom { height: var(--cv-height-mobile); }

  #CustomVideo-{{ sid }} .custom-video__media video,
  #CustomVideo-{{ sid }} .custom-video__placeholder svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #CustomVideo-{{ sid }} .custom-video__placeholder {
    aspect-ratio: 16 / 9;
    background: rgb(0 0 0 / 0.05);
  }

  #CustomVideo-{{ sid }} .custom-video__media--mobile { display: none; }

  @media (max-width: 749px) {
    #CustomVideo-{{ sid }}.custom-video--boxed {
      padding-left: 16px;
      padding-right: 16px;
    }

    #CustomVideo-{{ sid }} .custom-video__media--desktop { display: none; }
    #CustomVideo-{{ sid }} .custom-video__media--mobile { display: block; }

    #CustomVideo-{{ sid }} .custom-video__sound {
      top: calc(var(--cv-pad-top) + 12px);
      right: 12px;
      width: 36px;
      height: 36px;
    }
    #CustomVideo-{{ sid }}.custom-video--boxed .custom-video__sound { right: 28px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('CustomVideo-{{ sid }}');
    if (!root) return;

    var desktop = root.querySelector('.custom-video__media--desktop video');
    var mobile = root.querySelector('.custom-video__media--mobile video');
    var soundBtn = root.querySelector('.custom-video__sound');
    var mq = window.matchMedia('(max-width: 749px)');

    // soundOn = what the shopper wants; browsers may still force mute until they click/tap somewhere
    var soundOn = {{ section.settings.sound_on_default | json }} && !!soundBtn;
    var inView = true;
    // Hold off downloading the heavy video file until the page has loaded,
    // so the poster image (LCP) paints first without competing for bandwidth.
    var ready = false;

    function activeVideo() {
      return mq.matches ? mobile : desktop;
    }

    function updateButton() {
      if (!soundBtn) return;
      var active = activeVideo();
      var muted = !active || active.muted;
      soundBtn.classList.toggle('is-muted', muted);
      soundBtn.setAttribute('aria-pressed', muted ? 'false' : 'true');
      soundBtn.setAttribute('aria-label', muted ? soundBtn.dataset.labelOff : soundBtn.dataset.labelOn);
    }

    function play(video) {
      video.muted = !soundOn;
      var p = video.play();
      if (p && p.catch) {
        p.catch(function () {
          // Autoplay with sound blocked - play muted, unmute on first interaction
          video.muted = true;
          video.play().catch(function () {});
          updateButton();
        });
      }
      updateButton();
    }

    // Only the video for the current screen loads and plays
    function sync() {
      var active = activeVideo();
      var idle = mq.matches ? desktop : mobile;
      if (idle) idle.pause();
      if (!active) return;
      if (ready && inView) {
        active.preload = 'auto';
        play(active);
      } else {
        active.pause();
      }
    }

    if (soundBtn) {
      soundBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var active = activeVideo();
        soundOn = !!(active && active.muted);
        if (active) play(active);
      });

      // First click/tap/key anywhere on the page unlocks sound if it should be on
      var unlock = function (e) {
        // A tap on the sound button itself is handled by its click handler
        if (e && soundBtn.contains(e.target)) return;
        document.removeEventListener('pointerdown', unlock, true);
        document.removeEventListener('keydown', unlock, true);
        var active = activeVideo();
        if (soundOn && active && active.muted && inView) {
          active.muted = false;
          updateButton();
        }
      };
      document.addEventListener('pointerdown', unlock, true);
      document.addEventListener('keydown', unlock, true);
    }

    // Pause when scrolled away so sound doesn't play off-screen
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        inView = entries[0].isIntersecting;
        sync();
      }, { threshold: 0.25 }).observe(root);
    }

    // Start the video only after the page finishes loading (then when idle),
    // so it never delays the first paint / LCP.
    function begin() {
      ready = true;
      sync();
    }
    var defer = window.requestIdleCallback || function (cb) { return setTimeout(cb, 200); };
    if (document.readyState === 'complete') {
      defer(begin);
    } else {
      window.addEventListener('load', function () { defer(begin); }, { once: true });
    }

    sync();
    if (mq.addEventListener) mq.addEventListener('change', sync);
    else if (mq.addListener) mq.addListener(sync);
  })();
</script>

{% schema %}
{
  "name": "Custom video",
  "tag": "section",
  "class": "section-custom-video",
  "settings": [
    { "type": "header", "content": "Desktop" },
    { "type": "video", "id": "video_desktop", "label": "Desktop video" },
    {
      "type": "select", "id": "size_desktop", "label": "Desktop height",
      "options": [
        { "value": "adapt", "label": "Adapt to video" },
        { "value": "screen", "label": "Full screen" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "adapt"
    },
    {
      "type": "range", "id": "height_desktop", "label": "Custom desktop height",
      "min": 200, "max": 1000, "step": 20, "unit": "px", "default": 600,
      "info": "Used when height is Custom."
    },
    { "type": "header", "content": "Mobile" },
    {
      "type": "video", "id": "video_mobile", "label": "Mobile video",
      "info": "Vertical video works best. Leave empty to use the desktop video."
    },
    {
      "type": "select", "id": "size_mobile", "label": "Mobile height",
      "options": [
        { "value": "adapt", "label": "Adapt to video" },
        { "value": "screen", "label": "Full screen" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "adapt"
    },
    {
      "type": "range", "id": "height_mobile", "label": "Custom mobile height",
      "min": 200, "max": 900, "step": 20, "unit": "px", "default": 500,
      "info": "Used when height is Custom."
    },
    { "type": "header", "content": "Sound" },
    { "type": "checkbox", "id": "show_sound_button", "label": "Show sound on/off button", "default": true },
    {
      "type": "checkbox", "id": "sound_on_default", "label": "Sound on by default", "default": true,
      "info": "Browsers block sound until the visitor clicks or taps the page, so sound starts on their first tap."
    },
    { "type": "header", "content": "Link" },
    { "type": "url", "id": "link", "label": "Video link", "info": "Optional. Makes the whole video clickable." },
    { "type": "text", "id": "link_label", "label": "Link label (for screen readers)", "default": "Shop now" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    {
      "type": "range", "id": "padding_top", "label": "Top padding",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    },
    {
      "type": "range", "id": "padding_bottom", "label": "Bottom padding",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "Custom video" }
  ]
}
{% endschema %}
