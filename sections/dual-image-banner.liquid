{%- assign sid = section.id -%}

<section
  id="DualBanner-{{ sid }}"
  class="dual-banner"
  style="
    --db-bg: {{ section.settings.bg_color }};
    --db-gap: {{ section.settings.gap }}px;
    --db-gap-mobile: {{ section.settings.gap_mobile }}px;
    --db-max-width: {{ section.settings.max_width }}px;
    --db-ratio: {{ section.settings.image_ratio }};
    --db-ratio-mobile: {{ section.settings.image_ratio_mobile }};
    --db-pad-top: {{ section.settings.padding_top }}px;
    --db-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="dual-banner__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign bs = block.settings
        assign overlay_alpha = bs.overlay_opacity | divided_by: 100.0
        assign img_alt = bs.image.alt | default: bs.heading_line_1 | escape
        assign has_link = false
        if bs.link != blank
          assign has_link = true
        endif
      -%}
      <div
        class="dual-banner__card dual-banner__card--{{ bs.content_position }}"
        style="
          --db-heading: {{ bs.heading_color }};
          --db-text: {{ bs.text_color }};
          --db-accent: {{ bs.accent_color }};
          --db-overlay: {{ bs.overlay_color | color_modify: 'alpha', overlay_alpha }};
        "
        {{ block.shopify_attributes }}
      >
        {%- if has_link and bs.full_card_link -%}
          <a href="{{ bs.link }}" class="dual-banner__card-link" aria-label="{{ bs.heading_line_1 | strip_html | escape }} {{ bs.heading_line_2 | strip_html | escape }}"></a>
        {%- endif -%}

        <div class="dual-banner__media">
          {%- if bs.image != blank -%}
            {%- capture sizes -%}(min-width: 750px) {% if section.blocks.size > 1 %}50vw{% else %}100vw{% endif %}, 100vw{%- endcapture -%}
            {%- if bs.image_mobile != blank -%}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ bs.image_mobile | image_url: width: 750 }} 750w, {{ bs.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
                {{ bs.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: sizes, widths: '600, 900, 1200, 1600, 2000', class: 'dual-banner__img', alt: img_alt }}
              </picture>
            {%- else -%}
              {{ bs.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: sizes, widths: '600, 900, 1200, 1600, 2000', class: 'dual-banner__img', alt: img_alt }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'dual-banner__img dual-banner__placeholder' }}
          {%- endif -%}
        </div>

        <div class="dual-banner__overlay" aria-hidden="true"></div>

        <div class="dual-banner__content">
          {%- if bs.heading_line_1 != blank or bs.heading_line_2 != blank -%}
            <h2 class="dual-banner__heading">
              {%- if bs.heading_line_1 != blank -%}
                <span class="dual-banner__heading-main">{{ bs.heading_line_1 }}</span>
              {%- endif -%}
              {%- if bs.heading_line_2 != blank -%}
                <span class="dual-banner__heading-sub">{{ bs.heading_line_2 }}</span>
              {%- endif -%}
            </h2>
          {%- endif -%}

          {%- if bs.description != blank -%}
            <div class="dual-banner__desc">{{ bs.description }}</div>
          {%- endif -%}

          {%- if bs.button_label != blank -%}
            {%- if has_link -%}
              <a href="{{ bs.link }}" class="dual-banner__btn">
            {%- else -%}
              <span class="dual-banner__btn">
            {%- endif -%}
              <span>{{ bs.button_label }}</span>
              <svg class="dual-banner__arrow" viewBox="0 0 24 12" width="22" height="11" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M0 6h22M17 1l5 5-5 5"/></svg>
            {%- if has_link -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  #DualBanner-{{ sid }} {
    background: var(--db-bg);
    padding: var(--db-pad-top) 16px var(--db-pad-bottom);
  }
  #DualBanner-{{ sid }} .dual-banner__grid {
    max-width: var(--db-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 2 }}, minmax(0, 1fr));
    gap: var(--db-gap);
  }
  #DualBanner-{{ sid }} .dual-banner__card {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--db-ratio);
    display: flex;
    align-items: center;
    isolation: isolate;
  }
  #DualBanner-{{ sid }} .dual-banner__card--bottom { align-items: flex-end; }
  #DualBanner-{{ sid }} .dual-banner__card--top { align-items: flex-start; }

  #DualBanner-{{ sid }} .dual-banner__card-link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  #DualBanner-{{ sid }} .dual-banner__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  #DualBanner-{{ sid }} .dual-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(.2,.7,.2,1);
  }
  #DualBanner-{{ sid }} .dual-banner__placeholder {
    background: #3a2c20;
    fill: rgba(255,255,255,.15);
  }
  #DualBanner-{{ sid }} .dual-banner__card:hover .dual-banner__img { transform: scale(1.04); }

  #DualBanner-{{ sid }} .dual-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, var(--db-overlay) 0%, transparent 70%);
    pointer-events: none;
  }

  #DualBanner-{{ sid }} .dual-banner__content {
    padding: clamp(28px, 7%, 64px);
    max-width: 62%;
    color: var(--db-text);
  }
  #DualBanner-{{ sid }} .dual-banner__heading {
    margin: 0 0 clamp(14px, 2vw, 26px);
    font-family: var(--font-heading--family);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: .02em;
  }
  #DualBanner-{{ sid }} .dual-banner__heading-main {
    display: block;
    color: var(--db-accent);
    font-size: clamp(28px, 3.4vw, 54px);
  }
  #DualBanner-{{ sid }} .dual-banner__heading-sub {
    display: block;
    color: var(--db-heading);
    font-size: clamp(20px, 2.5vw, 40px);
    margin-top: .1em;
  }
  #DualBanner-{{ sid }} .dual-banner__desc {
    font-family: var(--font-body--family);
    font-size: clamp(11px, 1vw, 15px);
    letter-spacing: .18em;
    line-height: 1.9;
    text-transform: uppercase;
    color: var(--db-text);
    margin-bottom: clamp(22px, 3.5vw, 52px);
  }
  #DualBanner-{{ sid }} .dual-banner__desc p { margin: 0; }

  #DualBanner-{{ sid }} .dual-banner__btn {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 8px;
    font-family: var(--font-body--family);
    font-size: clamp(12px, 1.05vw, 16px);
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--db-text);
    text-decoration: none;
    border-bottom: 1px solid var(--db-accent);
  }
  #DualBanner-{{ sid }} .dual-banner__arrow { transition: transform .35s ease; }
  #DualBanner-{{ sid }} .dual-banner__card:hover .dual-banner__arrow { transform: translateX(5px); }

  @media (max-width: 749px) {
    #DualBanner-{{ sid }} .dual-banner__grid {
      grid-template-columns: 1fr;
      gap: var(--db-gap-mobile);
    }
    #DualBanner-{{ sid }} .dual-banner__card { aspect-ratio: var(--db-ratio-mobile); }
    #DualBanner-{{ sid }} .dual-banner__content { max-width: 80%; }
    #DualBanner-{{ sid }} .dual-banner__heading-main { font-size: 30px; }
    #DualBanner-{{ sid }} .dual-banner__heading-sub { font-size: 22px; }
    #DualBanner-{{ sid }} .dual-banner__desc { font-size: 11px; letter-spacing: .14em; }
  }
</style>

{% schema %}
{
  "name": "Dual image banner",
  "tag": "div",
  "class": "section-dual-image-banner",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#F5F2EC" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Card ratio (desktop)",
      "options": [
        { "value": "16 / 10", "label": "Landscape (16:10)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" }
      ],
      "default": "16 / 10"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Card ratio (mobile)",
      "options": [
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" }
      ],
      "default": "1 / 1"
    },
    { "type": "range", "id": "gap", "label": "Gap between images (desktop)", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "gap_mobile", "label": "Gap between images (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "max_width", "label": "Max content width", "min": 1000, "max": 1900, "step": 20, "unit": "px", "default": 1600 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Image banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },

        { "type": "header", "content": "Content" },
        { "type": "text", "id": "heading_line_1", "label": "Heading (line 1, highlighted)", "default": "Regalia" },
        { "type": "text", "id": "heading_line_2", "label": "Heading (line 2)", "default": "of the Kings" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Powerful pieces<br>for the modern man.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "checkbox", "id": "full_card_link", "label": "Make whole image clickable", "default": true },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content vertical position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },

        { "type": "header", "content": "Colors" },
        { "type": "color", "id": "accent_color", "label": "Heading line 1 & underline", "default": "#D9C29A" },
        { "type": "color", "id": "heading_color", "label": "Heading line 2", "default": "#F3ECE0" },
        { "type": "color", "id": "text_color", "label": "Description & button", "default": "#F3ECE0" },
        { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#1A120B" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dual image banner",
      "blocks": [
        { "type": "banner" },
        {
          "type": "banner",
          "settings": {
            "heading_line_1": "Shringar",
            "heading_line_2": "of the Queens",
            "description": "<p>Sacred adornments<br>for the divine feminine.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
