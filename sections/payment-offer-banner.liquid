{% schema %}
{
  "name": "Payment Offer Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "If left blank, the desktop image will be used on mobile."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)",
      "info": "Makes the banner clickable."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "default": "Payment offer"
    }
  ],
  "presets": [
    {
      "name": "Payment Offer Banner"
    }
  ]
}
{% endschema %}

{% liquid
  assign desktop_image = section.settings.image_desktop
  assign mobile_image = section.settings.image_mobile
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
%}

{% if desktop_image != blank or mobile_image != blank %}
  <div class="payment-offer-banner">
    {% if section.settings.link != blank %}
      <a
        href="{{ section.settings.link }}"
        class="payment-offer-banner__link"
        {% if section.settings.open_in_new_tab %}
          target="_blank" rel="noopener"
        {% endif %}
      >
    {% endif %}

    {% if desktop_image != blank %}
      {{
        desktop_image
        | image_url: width: 3840
        | image_tag:
          width: desktop_image.width,
          height: desktop_image.height,
          alt: section.settings.alt_text,
          class: 'payment-offer-banner__image payment-offer-banner__image--desktop',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000, 3000, 3840',
          loading: 'lazy'
      }}
    {% endif %}

    {% if mobile_image != blank %}
      {{
        mobile_image
        | image_url: width: 1600
        | image_tag:
          width: mobile_image.width,
          height: mobile_image.height,
          alt: section.settings.alt_text,
          class: 'payment-offer-banner__image payment-offer-banner__image--mobile',
          sizes: '100vw',
          widths: '400, 600, 800, 1200, 1600',
          loading: 'lazy'
      }}
    {% endif %}

    {% if section.settings.link != blank %}
      </a>
    {% endif %}
  </div>
{% endif %}

<style>
  .payment-offer-banner {
    width: 100%;
    line-height: 0;
  }

  .payment-offer-banner__link {
    display: block;
  }

  .payment-offer-banner__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .payment-offer-banner__image--mobile {
    display: block;
  }

  .payment-offer-banner__image--desktop {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .payment-offer-banner__image--mobile {
      display: none;
    }

    .payment-offer-banner__image--desktop {
      display: block;
    }
  }
</style>
