{%- liquid
  assign sid = section.id
-%}

<section
  id="MultiTab-{{ sid }}"
  class="multi-tab"
  style="
    --mt-per-view: {{ section.settings.per_view_desktop }};
    --mt-per-view-mobile: {{ section.settings.per_view_mobile }};
    --mt-gap: {{ section.settings.gap }}px;
    --mt-bg: {{ section.settings.bg_color }};
    --mt-text: {{ section.settings.text_color }};
    --mt-muted: {{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
    --mt-pad-top: {{ section.settings.padding_top }}px;
    --mt-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="multi-tab__header">
    <div class="multi-tab__intro">
      {%- for block in section.blocks -%}
        <div
          class="multi-tab__intro-item"
          data-tab-intro="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.kicker != blank -%}
            <p class="multi-tab__kicker">{{ block.settings.kicker }}</p>
          {%- endif -%}
          <div class="multi-tab__title-row">
            {%- if block.settings.heading != blank -%}
              <h2 class="multi-tab__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <span class="multi-tab__subheading">{{ block.settings.subheading }}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.description != blank -%}
            <div class="multi-tab__desc">{{ block.settings.description }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="multi-tab__pills" role="tablist">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="multi-tab__pill"
            role="tab"
            id="MultiTabPill-{{ block.id }}"
            aria-controls="MultiTabPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-tab-index="{{ forloop.index0 }}"
          >
            {{ block.settings.tab_label | default: block.settings.collection.title | default: 'Tab' }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- assign collection = block.settings.collection -%}
    <div
      class="multi-tab__panel"
      id="MultiTabPanel-{{ block.id }}"
      role="tabpanel"
      aria-labelledby="MultiTabPill-{{ block.id }}"
      data-tab-panel="{{ forloop.index0 }}"
      {% unless forloop.first %}hidden{% endunless %}
    >
      <div class="multi-tab__track">
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: block.settings.products_count -%}
            <div class="multi-tab__slide">
              <div class="multi-tab__card">
                {%- render 'resource-card',
                  resource: product,
                  resource_type: 'product',
                  image_aspect_ratio: section.settings.image_ratio,
                  image_hover: section.settings.image_hover,
                  image_width: 800,
                  image_sizes: '(min-width: 750px) 25vw, 50vw'
                -%}
                {%- if section.settings.show_badges -%}
                  {%- render 'product-card-badges', product: product, settings: settings -%}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..5) -%}
            <div class="multi-tab__slide">
              <div class="multi-tab__card multi-tab__card--placeholder">
                <div class="multi-tab__placeholder-media" style="aspect-ratio: {{ section.settings.image_ratio }};">
                  {%- assign placeholder_name = 'product-' | append: forloop.index -%}
                  {{ placeholder_name | placeholder_svg_tag }}
                </div>
                <p class="multi-tab__placeholder-title paragraph">Product title</p>
                <p class="multi-tab__placeholder-price paragraph">{{ 1999 | money }}</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if block.settings.button_label != blank and collection != blank -%}
        <div class="multi-tab__footer">
          <a href="{{ collection.url }}" class="multi-tab__view-all">{{ block.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}

  {%- if section.settings.show_divider -%}
    <div class="multi-tab__divider" aria-hidden="true">
      <span class="multi-tab__progress" data-tab-progress></span>
    </div>
  {%- endif -%}
</section>

<style>
  #MultiTab-{{ sid }} {
    padding: var(--mt-pad-top) 24px var(--mt-pad-bottom);
    background: var(--mt-bg);
    color: var(--mt-text);
  }

  #MultiTab-{{ sid }} .multi-tab__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  #MultiTab-{{ sid }} .multi-tab__intro { min-width: 0; }

  #MultiTab-{{ sid }} .multi-tab__kicker {
    margin: 0 0 6px;
    font-size: 14px;
    color: var(--mt-muted);
    text-transform: uppercase;
  }

  #MultiTab-{{ sid }} .multi-tab__title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  #MultiTab-{{ sid }} .multi-tab__heading {
    margin: 0;
    color: var(--mt-text);
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: 700;
    line-height: 1.1;
  }

  #MultiTab-{{ sid }} .multi-tab__subheading {
    font-size: 15px;
    color: var(--mt-muted);
  }

  #MultiTab-{{ sid }} .multi-tab__desc {
    max-width: 560px;
    margin-top: 8px;
    font-size: 14px;
    color: var(--mt-muted);
  }

  #MultiTab-{{ sid }} .multi-tab__desc p { margin: 0; }

  #MultiTab-{{ sid }} .multi-tab__pills {
    display: flex;
    flex-shrink: 0;
    gap: 10px;
  }

  #MultiTab-{{ sid }} .multi-tab__pill {
    flex-shrink: 0;
    min-width: 80px;
    padding: 9px 22px;
    border: 1px solid var(--mt-text);
    border-radius: {{ section.settings.pill_radius }}px;
    background: transparent;
    color: var(--mt-text);
    font: inherit;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  #MultiTab-{{ sid }} .multi-tab__pill[aria-selected="true"] {
    background: var(--mt-text);
    color: var(--mt-bg);
  }

  #MultiTab-{{ sid }} .multi-tab__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--mt-per-view) - 1) * var(--mt-gap)) / var(--mt-per-view));
    gap: var(--mt-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #MultiTab-{{ sid }} .multi-tab__track::-webkit-scrollbar,
  #MultiTab-{{ sid }} .multi-tab__pills::-webkit-scrollbar { display: none; }

  #MultiTab-{{ sid }} .multi-tab__slide {
    min-width: 0;
    scroll-snap-align: start;
  }

  #MultiTab-{{ sid }} .multi-tab__card {
    --padding-block-start: 0px;
    --padding-inline-start: 0px;
    --border-radius: 0px;
    --resource-card-corner-radius: {{ section.settings.card_radius }}px;
    position: relative;
    height: 100%;
  }

  #MultiTab-{{ sid }} .multi-tab__card .resource-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--resource-card-corner-radius);
  }

  #MultiTab-{{ sid }} .multi-tab__card .resource-card__image {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.4s ease;
  }

  #MultiTab-{{ sid }} .multi-tab__card .resource-card__content {
    padding-inline: 2px;
    color: var(--mt-text);
  }

  #MultiTab-{{ sid }} .multi-tab__card .product-badges { z-index: 2; pointer-events: none; }

  #MultiTab-{{ sid }} .multi-tab__placeholder-media {
    overflow: hidden;
    border-radius: var(--resource-card-corner-radius);
    background: rgb(0 0 0 / 0.05);
  }

  #MultiTab-{{ sid }} .multi-tab__placeholder-media svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--mt-muted);
  }

  #MultiTab-{{ sid }} .multi-tab__placeholder-title,
  #MultiTab-{{ sid }} .multi-tab__placeholder-price {
    margin: 0;
    padding-inline: 2px;
  }

  #MultiTab-{{ sid }} .multi-tab__placeholder-title { margin-top: var(--padding-xs, 8px); }
  #MultiTab-{{ sid }} .multi-tab__placeholder-price { font-weight: 500; }

  #MultiTab-{{ sid }} .multi-tab__footer {
    margin-top: 24px;
    text-align: center;
  }

  #MultiTab-{{ sid }} .multi-tab__view-all {
    display: inline-block;
    padding: 10px 28px;
    border: 1px solid var(--mt-text);
    color: var(--mt-text);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  #MultiTab-{{ sid }} .multi-tab__divider {
    position: relative;
    height: 3px;
    margin: 40px 0 0;
    overflow: hidden;
    background: {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
  }

  #MultiTab-{{ sid }} .multi-tab__progress {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: var(--mt-text);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.15s linear;
  }

  @media (max-width: 749px) {
    #MultiTab-{{ sid }} { padding-left: 16px; padding-right: 16px; }

    #MultiTab-{{ sid }} .multi-tab__header {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    /* Too many pills on phone → swipe sideways */
    #MultiTab-{{ sid }} .multi-tab__pills {
      margin: 0 -16px;
      padding: 0 16px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    /* Track runs edge to edge so the next product peeks in */
    #MultiTab-{{ sid }} .multi-tab__track {
      grid-auto-columns: calc((100% - 32px - (var(--mt-per-view-mobile) - 1) * var(--mt-gap)) / var(--mt-per-view-mobile));
      margin: 0 -16px;
      padding: 0 16px;
      scroll-padding: 0 16px;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('MultiTab-{{ sid }}');
    if (!root) return;

    var pills = root.querySelectorAll('[data-tab-index]');
    var intros = root.querySelectorAll('[data-tab-intro]');
    var panels = root.querySelectorAll('[data-tab-panel]');
    var progress = root.querySelector('[data-tab-progress]');
    var activeTrack = root.querySelector('[data-tab-panel]:not([hidden]) .multi-tab__track');

    function updateProgress() {
      if (!progress || !activeTrack) return;
      var max = activeTrack.scrollWidth;
      var ratio = max > 0 ? (activeTrack.scrollLeft + activeTrack.clientWidth) / max : 1;
      progress.style.transform = 'scaleX(' + Math.min(1, Math.max(0, ratio)) + ')';
    }

    root.querySelectorAll('.multi-tab__track').forEach(function (track) {
      track.addEventListener('scroll', function () {
        if (track === activeTrack) updateProgress();
      }, { passive: true });
    });
    window.addEventListener('resize', updateProgress);
    window.addEventListener('load', updateProgress);

    function show(index) {
      pills.forEach(function (pill, i) {
        pill.setAttribute('aria-selected', i === index ? 'true' : 'false');
        if (i === index) {
          var bar = pill.parentElement;
          bar.scrollTo({ left: pill.offsetLeft - (bar.clientWidth - pill.clientWidth) / 2, behavior: 'smooth' });
        }
      });
      intros.forEach(function (el, i) { el.hidden = i !== index; });
      panels.forEach(function (el, i) {
        el.hidden = i !== index;
        if (i === index) {
          activeTrack = el.querySelector('.multi-tab__track');
          activeTrack.scrollLeft = 0;
        }
      });
      updateProgress();
    }

    updateProgress();

    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        show(parseInt(pill.dataset.tabIndex, 10));
      });
    });

    // Theme editor: selecting a block opens its tab
    document.addEventListener('shopify:block:select', function (e) {
      if (e.detail.sectionId !== '{{ sid }}') return;
      var intro = root.querySelector('[data-tab-intro][data-shopify-editor-block*="' + e.detail.blockId + '"]');
      if (intro) show(parseInt(intro.dataset.tabIntro, 10));
    });
  })();
</script>

{% schema %}
{
  "name": "Multi tab collection",
  "tag": "div",
  "class": "section-multi-tab",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "range", "id": "per_view_desktop", "label": "Products visible (desktop)",
      "min": 2, "max": 6, "step": 1, "default": 5
    },
    {
      "type": "select", "id": "per_view_mobile", "label": "Products visible (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.3", "label": "1 + peek" },
        { "value": "2", "label": "2" },
        { "value": "2.3", "label": "2 + peek" }
      ],
      "default": "2"
    },
    {
      "type": "range", "id": "gap", "label": "Gap between products",
      "min": 0, "max": 32, "step": 2, "unit": "px", "default": 2
    },
    {
      "type": "range", "id": "pill_radius", "label": "Tab pill roundness",
      "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0
    },
    { "type": "header", "content": "Product card" },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "2 / 3", "label": "Tall (2:3)" }
      ],
      "default": "4 / 5"
    },
    { "type": "checkbox", "id": "image_hover", "label": "Show second image on hover", "default": true },
    { "type": "checkbox", "id": "show_badges", "label": "Show badges (sold out, label, rating)", "default": true },
    {
      "type": "range", "id": "card_radius", "label": "Image corner radius",
      "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0
    },
    { "type": "checkbox", "id": "show_divider", "label": "Show bottom divider line", "default": true },
    {
      "type": "range", "id": "padding_top", "label": "Top padding",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range", "id": "padding_bottom", "label": "Bottom padding",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab name (pill)", "default": "Men" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        {
          "type": "range", "id": "products_count", "label": "Products to show",
          "min": 2, "max": 24, "step": 1, "default": 10
        },
        { "type": "header", "content": "Left side text" },
        { "type": "text", "id": "kicker", "label": "Small text above heading", "default": "SS26" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Beyond Basics" },
        { "type": "text", "id": "subheading", "label": "Text next to heading", "default": "/ Collection" },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "text", "id": "button_label", "label": "View all button", "info": "Leave empty to hide." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi tab collection",
      "blocks": [
        { "type": "tab", "settings": { "tab_label": "Men" } },
        { "type": "tab", "settings": { "tab_label": "Women" } }
      ]
    }
  ]
}
{% endschema %}
