{%- liquid
  assign sid = section.id
  assign stone_parts = section.settings.stone_metafield | split: '.'
  assign meaning_parts = section.settings.meaning_metafield | split: '.'
-%}

<section
  id="FcTabs-{{ sid }}"
  class="fc-tabs"
  style="
    --fc-bg: {{ section.settings.bg_color }};
    --fc-text: {{ section.settings.text_color }};
    --fc-muted: {{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
    --fc-line: {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
    --fc-per-view: {{ section.settings.per_view_desktop }};
    --fc-per-view-tablet: {{ section.settings.per_view_tablet }};
    --fc-per-view-mobile: {{ section.settings.per_view_mobile }};
    --fc-gap: {{ section.settings.gap }}px;
    --fc-gap-mobile: {{ section.settings.gap_mobile }}px;
    --fc-ratio: {{ section.settings.image_ratio }};
    --fc-pad-top: {{ section.settings.padding_top }}px;
    --fc-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="fc-tabs__inner">
    <div class="fc-tabs__header">
      {%- if section.settings.subheading != blank -%}
        <p class="fc-tabs__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fc-tabs__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="fc-tabs__desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="fc-tabs__nav-scroll">
        <div class="fc-tabs__nav" role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="fc-tabs__tab"
              role="tab"
              id="FcTab-{{ block.id }}"
              aria-controls="FcPanel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-fc-tab="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_label | default: block.settings.collection.title | default: 'Tab' }}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <div
        class="fc-tabs__panel"
        id="FcPanel-{{ block.id }}"
        role="tabpanel"
        aria-labelledby="FcTab-{{ block.id }}"
        data-fc-panel="{{ forloop.index0 }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <div class="fc-tabs__slider">
          <button type="button" class="fc-tabs__arrow fc-tabs__arrow--prev" data-fc-prev aria-label="Previous" hidden>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
          </button>

          <div class="fc-tabs__track" data-fc-track>
            {%- if collection != blank and collection.products_count > 0 -%}
              {%- for product in collection.products limit: block.settings.products_limit -%}
                {%- liquid
                  assign stone = blank
                  assign meaning = blank
                  if stone_parts.size == 2
                    assign stone = product.metafields[stone_parts[0]][stone_parts[1]].value
                  endif
                  if meaning_parts.size == 2
                    assign meaning = product.metafields[meaning_parts[0]][meaning_parts[1]].value
                  endif
                  assign second_image = product.media[1]
                -%}
                <div class="fc-tabs__slide">
                  <div class="fc-card">
                    <div class="fc-card__media-wrap">
                      <a href="{{ product.url }}" class="fc-card__media" tabindex="-1" aria-hidden="true">
                        {%- if product.featured_media -%}
                          {{
                            product.featured_media
                            | image_url: width: 900
                            | image_tag:
                              loading: 'lazy',
                              class: 'fc-card__img',
                              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 85vw',
                              widths: '360, 540, 720, 900',
                              alt: product.featured_media.alt
                              | default: product.title
                          }}
                          {%- if section.settings.image_hover and second_image -%}
                            {{
                              second_image
                              | image_url: width: 900
                              | image_tag:
                                loading: 'lazy',
                                class: 'fc-card__img fc-card__img--hover',
                                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 85vw',
                                widths: '360, 540, 720, 900',
                                alt: ''
                            }}
                          {%- endif -%}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'fc-card__img fc-card__placeholder' }}
                        {%- endif -%}
                      </a>

                      {%- if section.settings.show_wishlist -%}
                        <button
                          type="button"
                          class="fc-card__wish"
                          data-fc-wish="{{ product.handle }}"
                          aria-label="Add {{ product.title | escape }} to wishlist"
                          aria-pressed="false"
                        >
                          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.5"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.6 4.5 7 4.5c2 0 3.6 1.1 5 3 1.4-1.9 3-3 5-3 3.4 0 5.6 3.4 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2z"/></svg>
                        </button>
                      {%- endif -%}

                      {%- if section.settings.show_sale_badge and product.compare_at_price > product.price -%}
                        <span class="fc-card__badge">Sale</span>
                      {%- endif -%}
                    </div>

                    <a href="{{ product.url }}" class="fc-card__info">
                      <h3 class="fc-card__title">{{ product.title }}</h3>
                      {%- if stone != blank or meaning != blank -%}
                        <p class="fc-card__meta">
                          {%- if stone != blank -%}<span>{{ stone }}</span>{%- endif -%}
                          {%- if stone != blank and meaning != blank -%}<span class="fc-card__dot" aria-hidden="true">•</span>{%- endif -%}
                          {%- if meaning != blank -%}<span>{{ meaning }}</span>{%- endif -%}
                        </p>
                      {%- endif -%}
                      <p class="fc-card__price">
                        <span>{{ product.price | money_without_trailing_zeros }}</span>
                        {%- if product.compare_at_price > product.price -%}
                          <s class="fc-card__compare">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                        {%- endif -%}
                      </p>
                    </a>
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div class="fc-tabs__slide">
                  <div class="fc-card">
                    <div class="fc-card__media-wrap">
                      <div class="fc-card__media">
                        {%- assign placeholder_name = 'product-' | append: forloop.index -%}
                        {{ placeholder_name | placeholder_svg_tag: 'fc-card__img fc-card__placeholder' }}
                      </div>
                    </div>
                    <div class="fc-card__info">
                      <h3 class="fc-card__title">Product title</h3>
                      <p class="fc-card__meta"><span>Stone</span><span class="fc-card__dot">•</span><span>Meaning</span></p>
                      <p class="fc-card__price">{{ 399900 | money_without_trailing_zeros }}</p>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <button type="button" class="fc-tabs__arrow fc-tabs__arrow--next" data-fc-next aria-label="Next" hidden>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>

        {%- if block.settings.button_label != blank and collection != blank -%}
          <div class="fc-tabs__footer">
            <a href="{{ collection.url }}" class="fc-tabs__view-all">{{ block.settings.button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  #FcTabs-{{ sid }} {
    background: var(--fc-bg);
    color: var(--fc-text);
    padding: var(--fc-pad-top) 0 var(--fc-pad-bottom);
  }
  #FcTabs-{{ sid }} .fc-tabs__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Header */
  #FcTabs-{{ sid }} .fc-tabs__header { text-align: center; margin-bottom: 32px; }
  #FcTabs-{{ sid }} .fc-tabs__subheading {
    margin: 0 0 12px;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--fc-muted);
  }
  #FcTabs-{{ sid }} .fc-tabs__heading {
    margin: 0 0 12px;
    font-family: var(--font-heading--family);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fc-text);
  }
  #FcTabs-{{ sid }} .fc-tabs__desc {
    font-family: var(--font-body--family);
    font-size: 16px;
    color: var(--fc-muted);
  }
  #FcTabs-{{ sid }} .fc-tabs__desc p { margin: 0; }

  /* Tabs — centred when they fit, scrollable when they don't */
  #FcTabs-{{ sid }} .fc-tabs__nav-scroll {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 32px;
  }
  #FcTabs-{{ sid }} .fc-tabs__nav-scroll::-webkit-scrollbar { display: none; }
  #FcTabs-{{ sid }} .fc-tabs__nav {
    display: flex;
    gap: 48px;
    width: max-content;
    margin: 0 auto;
  }
  #FcTabs-{{ sid }} .fc-tabs__tab {
    position: relative;
    flex: 0 0 auto;
    padding: 6px 0 10px;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--fc-muted);
    transition: color 0.25s ease;
  }
  #FcTabs-{{ sid }} .fc-tabs__tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }
  #FcTabs-{{ sid }} .fc-tabs__tab:hover,
  #FcTabs-{{ sid }} .fc-tabs__tab[aria-selected='true'] { color: var(--fc-text); }
  #FcTabs-{{ sid }} .fc-tabs__tab[aria-selected='true'] { font-weight: 600; }
  #FcTabs-{{ sid }} .fc-tabs__tab[aria-selected='true']::after { transform: scaleX(1); }

  /* Panels */
  #FcTabs-{{ sid }} .fc-tabs__panel { animation: fcFade-{{ sid }} 0.4s ease; }
  #FcTabs-{{ sid }} .fc-tabs__panel[hidden] { display: none; }
  @keyframes fcFade-{{ sid }} {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  /* Slider */
  #FcTabs-{{ sid }} .fc-tabs__slider { position: relative; }
  #FcTabs-{{ sid }} .fc-tabs__track {
    display: flex;
    gap: var(--fc-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  #FcTabs-{{ sid }} .fc-tabs__track::-webkit-scrollbar { display: none; }
  #FcTabs-{{ sid }} .fc-tabs__slide {
    flex: 0 0 calc((100% - (var(--fc-per-view) - 1) * var(--fc-gap)) / var(--fc-per-view));
    min-width: 0;
    scroll-snap-align: start;
  }

  #FcTabs-{{ sid }} .fc-tabs__arrow {
    position: absolute;
    top: calc(var(--fc-arrow-top, 40%));
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--fc-line);
    background: var(--fc-bg);
    color: var(--fc-text);
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transition: opacity 0.2s ease;
  }
  #FcTabs-{{ sid }} .fc-tabs__arrow[hidden] { display: none; }
  #FcTabs-{{ sid }} .fc-tabs__arrow:disabled { opacity: 0.35; cursor: default; }
  #FcTabs-{{ sid }} .fc-tabs__arrow--prev { left: -22px; }
  #FcTabs-{{ sid }} .fc-tabs__arrow--next { right: -22px; }

  /* Card */
  #FcTabs-{{ sid }} .fc-card__media-wrap {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: var(--fc-line);
  }
  #FcTabs-{{ sid }} .fc-card__media {
    position: relative;
    display: block;
    aspect-ratio: var(--fc-ratio);
  }
  #FcTabs-{{ sid }} .fc-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease, opacity 0.5s ease;
  }
  #FcTabs-{{ sid }} .fc-card__img--hover { opacity: 0; }
  @media (hover: hover) {
    #FcTabs-{{ sid }} .fc-card:hover .fc-card__img { transform: scale(1.04); }
    #FcTabs-{{ sid }} .fc-card:hover .fc-card__img--hover { opacity: 1; }
  }

  #FcTabs-{{ sid }} .fc-card__wish {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  #FcTabs-{{ sid }} .fc-card__wish svg { fill: transparent; transition: fill 0.2s ease; }
  #FcTabs-{{ sid }} .fc-card__wish:hover { transform: scale(1.08); background: rgba(255, 255, 255, 0.3); }
  #FcTabs-{{ sid }} .fc-card__wish[aria-pressed='true'] svg { fill: currentColor; }

  #FcTabs-{{ sid }} .fc-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--fc-bg);
    color: var(--fc-text);
  }

  #FcTabs-{{ sid }} .fc-card__info {
    display: block;
    padding-top: 20px;
    color: inherit;
    text-decoration: none;
  }
  #FcTabs-{{ sid }} .fc-card__title {
    margin: 0 0 10px;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fc-text);
  }
  #FcTabs-{{ sid }} .fc-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-family: var(--font-body--family);
    font-size: 14px;
    color: var(--fc-muted);
  }
  #FcTabs-{{ sid }} .fc-card__dot { font-size: 10px; }
  #FcTabs-{{ sid }} .fc-card__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 600;
    color: var(--fc-text);
  }
  #FcTabs-{{ sid }} .fc-card__compare {
    font-size: 14px;
    font-weight: 400;
    color: var(--fc-muted);
  }

  #FcTabs-{{ sid }} .fc-tabs__footer { text-align: center; margin-top: 40px; }
  #FcTabs-{{ sid }} .fc-tabs__view-all {
    display: inline-block;
    padding: 14px 36px;
    border: 1px solid var(--fc-text);
    color: var(--fc-text);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }
  #FcTabs-{{ sid }} .fc-tabs__view-all:hover { background: var(--fc-text); color: var(--fc-bg); }

  /* Tablet */
  @media (max-width: 989px) {
    #FcTabs-{{ sid }} .fc-tabs__inner { padding: 0 24px; }
    #FcTabs-{{ sid }} .fc-tabs__slide {
      flex-basis: calc((100% - (var(--fc-per-view-tablet) - 1) * var(--fc-gap)) / var(--fc-per-view-tablet));
    }
    #FcTabs-{{ sid }} .fc-tabs__nav { gap: 32px; }
  }

  /* Mobile — 1 + peek, full-bleed track */
  @media (max-width: 749px) {
    #FcTabs-{{ sid }} .fc-tabs__inner { padding: 0; }
    #FcTabs-{{ sid }} .fc-tabs__header { padding: 0 16px; margin-bottom: 24px; }
    #FcTabs-{{ sid }} .fc-tabs__subheading { font-size: 11px; margin-bottom: 10px; }
    #FcTabs-{{ sid }} .fc-tabs__heading { font-size: {{ section.settings.heading_size_mobile }}px; }
    #FcTabs-{{ sid }} .fc-tabs__desc { font-size: 14px; }

    #FcTabs-{{ sid }} .fc-tabs__nav-scroll { margin-bottom: 24px; }
    #FcTabs-{{ sid }} .fc-tabs__nav { gap: 28px; padding: 0 16px; }
    #FcTabs-{{ sid }} .fc-tabs__tab { font-size: 12px; }

    #FcTabs-{{ sid }} .fc-tabs__track {
      gap: var(--fc-gap-mobile);
      padding: 0 16px;
      scroll-padding-inline: 16px;
    }
    #FcTabs-{{ sid }} .fc-tabs__slide {
      flex-basis: calc((100% - 32px - (var(--fc-per-view-mobile) - 1) * var(--fc-gap-mobile)) / var(--fc-per-view-mobile));
    }
    #FcTabs-{{ sid }} .fc-tabs__arrow { display: none !important; }

    #FcTabs-{{ sid }} .fc-card__title { font-size: 14px; }
    #FcTabs-{{ sid }} .fc-card__meta { font-size: 13px; gap: 8px; }
    #FcTabs-{{ sid }} .fc-card__price { font-size: 16px; }
    #FcTabs-{{ sid }} .fc-card__info { padding-top: 16px; }
    #FcTabs-{{ sid }} .fc-tabs__footer { padding: 0 16px; margin-top: 28px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('FcTabs-{{ sid }}');
    if (!root) return;

    var tabs = root.querySelectorAll('[data-fc-tab]');
    var panels = root.querySelectorAll('[data-fc-panel]');
    var navScroll = root.querySelector('.fc-tabs__nav-scroll');
    var WISH_KEY = 'fc-wishlist';

    function updateArrows(panel) {
      var track = panel.querySelector('[data-fc-track]');
      var prev = panel.querySelector('[data-fc-prev]');
      var next = panel.querySelector('[data-fc-next]');
      if (!track || !prev || !next) return;
      var overflow = track.scrollWidth - track.clientWidth > 4;
      prev.hidden = next.hidden = !overflow;
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      var media = track.querySelector('.fc-card__media');
      if (media) root.style.setProperty('--fc-arrow-top', media.offsetHeight / 2 + 'px');
    }

    function activate(index) {
      tabs.forEach(function (tab, i) {
        var active = i === index;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
        if (active && navScroll && navScroll.scrollWidth > navScroll.clientWidth) {
          navScroll.scrollTo({
            left: tab.offsetLeft - (navScroll.clientWidth - tab.offsetWidth) / 2,
            behavior: 'smooth'
          });
        }
      });
      panels.forEach(function (panel, i) {
        panel.hidden = i !== index;
        if (i === index) {
          var track = panel.querySelector('[data-fc-track]');
          if (track) track.scrollLeft = 0;
          updateArrows(panel);
        }
      });
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () { activate(i); });
      tab.addEventListener('keydown', function (e) {
        var dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        var nextIndex = (i + dir + tabs.length) % tabs.length;
        activate(nextIndex);
        tabs[nextIndex].focus();
      });
      if (i !== 0) tab.tabIndex = -1;
    });

    panels.forEach(function (panel) {
      var track = panel.querySelector('[data-fc-track]');
      if (!track) return;
      function step() {
        var slide = track.querySelector('.fc-tabs__slide');
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return slide ? slide.offsetWidth + gap : track.clientWidth;
      }
      panel.querySelector('[data-fc-prev]').addEventListener('click', function () {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      panel.querySelector('[data-fc-next]').addEventListener('click', function () {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
      track.addEventListener('scroll', function () { updateArrows(panel); }, { passive: true });
    });

    window.addEventListener('resize', function () {
      panels.forEach(function (p) { if (!p.hidden) updateArrows(p); });
    });
    window.addEventListener('load', function () {
      panels.forEach(function (p) { if (!p.hidden) updateArrows(p); });
    });

    // Wishlist (stored per browser)
    function readWish() {
      try { return JSON.parse(localStorage.getItem(WISH_KEY)) || []; } catch (e) { return []; }
    }
    function writeWish(list) {
      try { localStorage.setItem(WISH_KEY, JSON.stringify(list)); } catch (e) {}
    }
    var wished = readWish();
    root.querySelectorAll('[data-fc-wish]').forEach(function (btn) {
      var handle = btn.getAttribute('data-fc-wish');
      btn.setAttribute('aria-pressed', wished.indexOf(handle) > -1 ? 'true' : 'false');
      btn.addEventListener('click', function () {
        var list = readWish();
        var idx = list.indexOf(handle);
        if (idx > -1) list.splice(idx, 1); else list.push(handle);
        writeWish(list);
        document.querySelectorAll('[data-fc-wish="' + handle + '"]').forEach(function (b) {
          b.setAttribute('aria-pressed', idx > -1 ? 'false' : 'true');
        });
      });
    });

    activate(0);
  })();
</script>

{% schema %}
{
  "name": "Featured collection tabs",
  "tag": "div",
  "class": "section-featured-collection-tabs",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Featured Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jewellery that carries a deeper meaning" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Crafted with intention. Designed for your next era.</p>" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "per_view_desktop", "label": "Products per row (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
