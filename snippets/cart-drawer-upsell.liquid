{%- doc -%}
  Simple "Pairs well with" upsell block for the cart drawer.
  Shows the a products picked in Theme settings > Cart > Upsell products, each with a small
  image, title, price and an Add to cart button. Merchant can change the products anytime
  from the theme editor - no code changes needed.

  Hidden automatically if the feature is off, no products are picked, or the cart is empty.

  @param {object} section - the section that rendered the cart drawer, needed so the drawer
  refreshes itself after an upsell product is added.
{%- enddoc -%}

{%- liquid
  assign upsell_products = settings.cart_upsell_products
-%}

{%- if settings.show_cart_upsell and upsell_products.size > 0 and cart.item_count > 0 -%}
  <div class="cart-upsell">
    <p class="cart-upsell__heading h6">
      {{- settings.cart_upsell_heading | default: 'Pairs well with' -}}
    </p>

    <div class="cart-upsell__list">
      {%- for product in upsell_products -%}
        {%- liquid
          assign variant = product.selected_or_first_available_variant
        -%}
        <div class="cart-upsell__card">
          <a
            href="{{ product.url }}"
            class="cart-upsell__image"
          >
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title }}
            {%- endif -%}
          </a>

          <a
            href="{{ product.url }}"
            class="cart-upsell__title"
          >
            {{- product.title -}}
          </a>

          <span class="cart-upsell__price">
            {{- variant.price | money -}}
          </span>

          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ product.id }}"
            on:submit="/handleSubmit"
          >
            {%- form 'product', product -%}
              <input
                type="hidden"
                name="id"
                value="{{ variant.id }}"
              >
              <button
                type="submit"
                class="button button-secondary cart-upsell__button"
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                {%- if variant.available -%}
                  {{- 'products.product.add_to_cart' | t -}}
                {%- else -%}
                  {{- 'products.product.sold_out' | t -}}
                {%- endif -%}
              </button>
            {%- endform -%}
          </product-form-component>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-upsell {
    padding-block: var(--gap-sm, 12px);
    padding-inline: var(--cart-drawer-padding);
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 10%);

    @media screen and (min-width: 750px) {
      padding-inline: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-upsell__heading {
    margin: 0 0 8px;
  }

  .cart-upsell__list {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .cart-upsell__list::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .cart-upsell__card {
    flex: 0 0 90px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cart-upsell__image {
    display: block;
  }

  .cart-upsell__image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }

  .cart-upsell__title {
    font-size: 0.6875rem;
    line-height: 1.2;
    color: var(--color-foreground);
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-upsell__title:hover {
    text-decoration: underline;
  }

  .cart-upsell__price {
    font-size: 0.6875rem;
  }

  .cart-upsell__button {
    width: 100%;
    padding-block: 4px;
    font-size: 0.6875rem;
  }
{% endstylesheet %}
