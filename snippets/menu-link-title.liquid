{%- doc -%}
  Renders a menu link title. Links listed in `highlight_handles` get an animated
  gradient title and a "New" badge.

  @param {object} link - The menu link
  @param {string} class - Class for the title span
{%- enddoc -%}

{%- assign highlight_handles = 'tatsatyuga,yuga-collections' | split: ',' -%}

{%- if highlight_handles contains link.handle -%}
  <span class="{{ class }} menu-link-highlight">
    <span class="menu-link-highlight__text">{{- link.title | escape -}}</span>
    <span class="menu-link-highlight__badge">New</span>
  </span>
{%- else -%}
  <span class="{{ class }}">{{- link.title | escape -}}</span>
{%- endif -%}

{% stylesheet %}
  .menu-link-highlight {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .menu-link-highlight__text,
  .menu-link-highlight__badge {
    background-image: linear-gradient(90deg, #f5a623, #ef6b2f, #e5352c, #ef6b2f, #f5a623);
    background-size: 200% auto;
    animation: menu-link-highlight-flow 3s linear infinite;
  }

  .menu-link-highlight__text {
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font-weight: 600;
  }

  .menu-link-highlight__badge {
    padding: 0.15em 0.5em;
    border-radius: 999px;
    color: #fff;
    font-size: 0.65em;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @keyframes menu-link-highlight-flow {
    to {
      background-position: -200% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-link-highlight__text,
    .menu-link-highlight__badge {
      animation: none;
    }
  }
{% endstylesheet %}
