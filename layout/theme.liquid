<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
<script> window.Shopflo = { ...(window.Shopflo ?? {}), autoOnboarding: true} </script>

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

         <!-- Gokwik theme code start -->

<link rel="dns-prefetch" href="https://pdp.gokwik.co/">
<link rel="dns-prefetch" href="https://api.gokwik.co">
{% render 'gokwik' %}

<script>
 function onCheckoutNow(e) {
   const dialog = document.querySelector('.cart-drawer dialog');
   const cart = document.querySelector('.cart-drawer');
   if (dialog?.hasAttribute('open')) {
     cart.close?.();
     setTimeout(() => {
       onCheckoutClick(e);
     }, 100);
   } else {
     onCheckoutClick(e);
   }
 }
</script>
<!-- Gokwik theme code End -->





    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

     {% comment %} start Crystal quick view button {% endcomment %}

    <!-- ================== Quick View Modal ================== -->
<!-- QUICKVIEW MODAL -->
<div id="quickview-modal" class="quickview-modal" style="display:none;">
  <div class="quickview-overlay"></div>
  <div class="quickview-box">
    <div class="closeBtn">
      <span class="quickview-close">&times;</span>
    </div>
    <div class="quickview-inner">
      <div class="quickview-left">
        <img id="quickview-image" src="" alt="">
      </div>
      <div class="quickview-right">
        <h2 id="quickview-title"></h2>
        <p id="quickview-desc"></p>
        <p class="quickview-vendor">By <span id="quickview-vendor"></span></p>
        <a id="read-more" class="next-btn bulk-btn" href="">Read More</a>
        <!-- PRICE: HIGHLIGHTED -->
        <p class="quickview-price" id="quickview-price" style="font-size:2rem;font-weight:700;color:#222;margin:10px 0 20px 0;">₹ 1599.00</p>
        <div id="quickview-rituals"></div>
        <div id="quickview-sizes"></div>
        <p class="stock-status"><span id="quickview-stock"></span></p>
        <div class="qty-box">
          <button class="qty-btn" onclick="updateQty(-1)">-</button>
          <input type="number" id="quickview-qty" value="1" min="1">
          <button class="qty-btn" onclick="updateQty(1)">+</button>
        </div>
        <button id="quickview-add" class="btn-cart" disabled>ADD TO CART</button>
        <br><br>
        
      </div>
    </div>
  </div>
</div>

<script>
let selectedRitual = null;
let selectedVariantId = null;
let groupedVariants = {};

function openQuickView(handle) {
  // Open the quick view modal instead of redirecting
  const modal = document.getElementById('quickview-modal');
  const title = document.getElementById('quickview-title');
  const desc = document.getElementById('quickview-desc');
  const vendor = document.getElementById('quickview-vendor');
  const price = document.getElementById('quickview-price');
  const image = document.getElementById('quickview-image');
  const stock = document.getElementById('quickview-stock');
  const ritualsDiv = document.getElementById('quickview-rituals');
  const sizesDiv = document.getElementById('quickview-sizes');
  const addBtn = document.getElementById('quickview-add');
  const readMore = document.getElementById("read-more");
  const tempDiv = document.createElement("div");
  selectedRitual = null;
  selectedVariantId = null;
  groupedVariants = {};

  fetch(`/products/${handle}.js`)
    .then((res) => res.json())
    .then((product) => {
      // Set product info
      title.textContent = product.title;
      tempDiv.innerHTML = product.description;
      let plainText = tempDiv.textContent || tempDiv.innerText || "";
      plainText = plainText.replace(/\s+/g, " ").trim();
      const maxChars = 180;
      if (plainText.length > maxChars) {
        plainText = plainText.substring(0, maxChars) + "...";
      }
      desc.textContent = plainText;
      vendor.textContent = product.vendor;
      image.src = product.images[0];
      readMore.href = `/products/${handle}`;
      stock.textContent = product.available ? 'In stock' : 'Out of stock';

      // Group variants by ritual type
     product.variants.forEach(v => {
  const ritual = v.option1 || 'Unknown';

  if (!groupedVariants[ritual]) {
    groupedVariants[ritual] = [];
  }

  groupedVariants[ritual].push(v);
});

      // Render ritual buttons
      ritualsDiv.innerHTML = '';
      Object.keys(groupedVariants).forEach(ritual => {
        let btn = document.createElement('button');
        btn.textContent = ritual;
        btn.className = 'ritual-btn';
        btn.onclick = () => {
          document.querySelectorAll('#quickview-rituals button').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          selectedRitual = ritual;
          selectedVariantId = null;
          renderSizes(groupedVariants[ritual]);
          addBtn.disabled = true;
          price.textContent = "";
        };
        ritualsDiv.appendChild(btn);
      });

      sizesDiv.innerHTML = '';
      addBtn.disabled = true;
      price.textContent = "";
      modal.style.display = 'block';
    });

  // Render size options
  function renderSizes(variantArr) {
    sizesDiv.innerHTML = '';
    let sizeMap = {};
    variantArr.forEach(v => {
    let sizeLabel = v.option2;
      if (!sizeMap[sizeLabel]) {
        sizeMap[sizeLabel] = v;
      }
    });
    Object.keys(sizeMap).forEach(sizeLabel => {
      let variant = sizeMap[sizeLabel];
      let btn = document.createElement('button');
      btn.textContent = sizeLabel;
      btn.className = 'size-btn';
      btn.onclick = () => {
        document.querySelectorAll('#quickview-sizes button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedVariantId = variant.id;
        addBtn.disabled = false;
        document.getElementById('quickview-price').textContent = '₹ ' + (variant.price / 100).toFixed(2);
      };
      sizesDiv.appendChild(btn);
    });
  }

  addBtn.onclick = () => {
    if (!selectedVariantId) return;
    const qty = parseInt(document.getElementById('quickview-qty').value);
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: selectedVariantId, quantity: qty }),
    })
      .then((res) => res.json())
      .then(() => {
        modal.style.display = 'none';
        updateCartDrawer();
        openCartDrawer();
      })
      .catch((err) => console.error('Cart Add Error:', err));
  };

  document.querySelector('.quickview-close').onclick = () => (modal.style.display = 'none');
  window.onclick = (e) => {
    if (e.target.classList.contains('quickview-overlay')) modal.style.display = 'none';
  };
}


function updateQty(change) {
  const qtyInput = document.getElementById('quickview-qty');
  let val = parseInt(qtyInput.value) + change;
  if (val < 1) val = 1;
  qtyInput.value = val;
}

function updateCartDrawer() {
  fetch('/cart?view=drawer')
    .then((res) => res.text())
    .then((html) => {
      document.querySelector('#cart-drawer').innerHTML = html;
    })
    .catch((err) => console.error('Cart Drawer Error:', err));
}
function openCartDrawer() {
  const drawer = document.querySelector('#cart-drawer');
  if (drawer) drawer.classList.add('open');
}
</script>

    <!-- ================== Styles ================== -->
    <style>
      /* Container spacing for neat layout */
      #quickview-rituals,
      #quickview-sizes {
      	display: flex;
      	flex-wrap: wrap;
      	gap: 10px;
      	margin: 20px 0 10px 0;
      }

      /* Attractive ritual and size button styles */
      .ritual-btn,
      .size-btn {
      	background: #fff;
      	color: #1a1a1a;
      	border: 2px solid #c8b288;
      	border-radius: 10px;
      	padding: 14px 12px;
      	font-size: 13px;
      	margin-bottom: 6px;
      	font-weight: 500;
      	box-shadow: 0 2px 7px #ebe7d4aa;
      	transition: all 0.18s cubic-bezier(0.25, 0.85, 0.35, 1);
      	cursor: pointer;
      	outline: none;
      	position: relative;
      }

      .ritual-btn:hover,
      .size-btn:hover {
      	background: #ede5d5;
      	color: #b3975d;
      	box-shadow: 0 3px 12px #d1b77b44;
      	border-color: #b3975d;
      }

      .ritual-btn.active,
      .size-btn.active {
      	background: linear-gradient(90deg, #e8dab1, #ecdabb 63%, #ead6c0);
      	color: #725312;
      	border-color: #b3975d;
      	box-shadow: 0 4px 16px #eeddbb77;
      	font-weight: 600;
      }

      @media (max-width:600px) {

      	.ritual-btn,
      	.size-btn {
      		font-size: 12px;
      		padding: 11px 11px;
      		margin-bottom: 5px;
      	}

      	#quickview-rituals,
      	#quickview-sizes {
      		gap: 10px;
      	}
      }

      .quickview-modal {
      	position: fixed;
      	top: 0;
      	left: 0;
      	width: 100%;
      	height: 100%;
      	background: rgba(0, 0, 0, 0.6);
      	z-index: 99999;
      	display: none;
      }

      .quickview-box {
      	background: #fff;
      	width: 90%;
      	max-width: 1000px;
      	margin: 40px auto;
      	border-radius: 8px;
      	position: relative;
      	overflow: hidden;
      	z-index: 999;
      }

      .quickview-close {
      	position: absolute;
      	top: 15px;
      	right: 20px;
      	cursor: pointer;
      	font-size: 24px;
      	font-weight: bold;
      }

      .quickview-inner {
      	display: flex;
      	gap: 16px;
      	flex-wrap: wrap;
      }

      .quickview-left {
      	flex: 1 1 45%;
      	text-align: center;
      }

      .quickview-left img {
      	max-width: 100%;
      	border-radius: 6px;
      }

      .quickview-right {
      	flex: 1 1 50%;
      }

      .quickview-right h2 {
      	font-size: 1.1rem;
        margin-bottom: 8px;
        font-weight: 600;
      }

      p#quickview-desc {
    padding-bottom: 16px;
}

      .quickview-vendor {
      	color: #777;
      	margin-bottom: 8px;
      	display: none;
      }

      .quickview-price {
      	font-size: 1.3rem;
      	font-weight: bold;
      	margin-bottom: 15px;
      }

      .stock-status {
      	margin-bottom: 15px;
      	color: green;
      	font-weight: 500;
      }

      /* Variant Options (button style) */
      #quickview-options button {
      	border: 1px solid #ccc;
      	padding: 8px 15px;
      	margin: 5px;
      	color: rgb(0, 0, 0);
      	cursor: pointer;
      	background: #fff;
      	border-radius: 4px;
      }

      #quickview-options button.active {
      	border-color: #000;
      	background: #cead80;
      	color: rgb(0, 0, 0);
      }

      /* Quantity box */
      .qty-box {
      	display: flex;
      	align-items: center;
      	margin: 15px 0;
      }

      .qty-btn {
      	width: 35px;
      	height: 35px;
      	border: 1px solid #ccc;
      	background: #f9f9f9;
      	cursor: pointer;
      	font-size: 18px;
      }

      #quickview-qty {
      	width: 60px;
      	text-align: center;
      	border: 1px solid #ccc;
      	height: 35px;
      	margin: 0 5px;
      }

      /* Add to Cart */
      .btn-cart {
      	background: #ceac80;
      	color: #fff;
      	border: none;
      	padding: 12px 25px;
      	font-size: 1rem;
      	border-radius: 4px;
      	cursor: pointer;
      	border: 1px solid;
      	width: 100%;
      }

      .btn-cart:hover {
      	background: #333;
      }

      @media (min-width: 768px) {
      	.quickview-left {
      		margin: auto;
      		padding-left: 26px;
      	}

      	#quickview-options button {
      		width: 47%;
      	}

      	.quickview-box {
      		height: auto;
      		padding: 30px 0;
      	}

      	.quickview-right {
      		padding: 20px 45px 0 0;
      	}

      }

      @media (max-width:425px) {

      	.quickview-right {
      		overflow: auto;
      		height: 300px;
      		padding: 0 20px 30px;
      	}

      	.quickview-inner {
      		gap: 20px;
          display: block;
      	}

      	.closeBtn {
      		background: #ceac80;
      		position: absolute;
      		width: 35px;
      		height: 35px;
      		right: 23px;
      		border-radius: 10px;
      		top: 6px;
      		border: 1.5px solid #000000;
      	}

      	.quickview-close {
      		position: absolute;
      		top: -2px;
      		right: 9px;
      	}

      	.quickview-box {
      		right: -18px;
      		width: 99%;
      		height: 100%;
      		margin: 0 auto;

      	}
      }

      @media (max-width: 375px) {

      	.quickview-right {
      		height: 400px;
      	}

      	.quickview-box {
      		right: -19px;
      	}

      }
    </style>
  


    {% comment %} End Crystal quick view button {% endcomment %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

