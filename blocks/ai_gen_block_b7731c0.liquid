{% doc %}
  @prompt
    in form of grid, I want to add collections here, There should not be any overlay text, remove the background color from card, do not make the image rounded overlay only collection name background golden in a rectangle, Not on hover always show the collection name, make it uppercase do not add any font weight make it light weight text. on hover do not do anything to background, The image should have the aspect ratio of 16:9, also the collection name text color should be white, The image should be in ratio of 0.76, width vs height. Do not show number of product below. The text of collection name should be fit of the collection name

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
  }

  .ai-collection-grid-item-{{ ai_gen_id }} {
    padding: {{ block.settings.item_padding }}px;
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    text-align: {{ block.settings.text_alignment }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-collection-grid-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-collection-grid-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.image_spacing }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-collection-grid-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;display: block;
  }

  .ai-collection-grid-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-grid-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-grid-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    background: {{ block.settings.overlay_color }};
    width: fit-content;
    padding: 12px 16px;
  }

  .ai-collection-grid-overlay-text-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: {{ block.settings.overlay_text_size }}px;
    font-weight: 300;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: fit-content;
  }

  @media screen and (max-width: 768px) {
    .ai-collection-grid-container-{{ ai_gen_id }} {
      {% if block.settings.columns_mobile == '1' %}
        grid-template-columns: 1fr 1fr;
      {% else %}
        grid-template-columns: repeat(2, 1fr);
      {% endif %}gap: {{ block.settings.gap | times: 0.75 }}px;padding: {{ block.settings.padding | times: 0.75 }}px;
    }

    .ai-collection-grid-overlay-text-{{ ai_gen_id }} {
      font-size: 9px;
    }
    .ai-collection-grid-overlay-aqlr6q2xgczzztjnhmaigenblockb7731c0gwa6aq {bottom:0;}
  }

  @media screen and (max-width: 1024px) and (min-width: 769px) {
    .ai-collection-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }
{% endstyle %}<div class="ai-collection-grid-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..12) %}
    {% liquid
      assign item_enabled_key = 'item_' | append: i | append: '_enabled'
      assign item_collection_key = 'item_' | append: i | append: '_collection'
      assign item_custom_title_key = 'item_' | append: i | append: '_custom_title'
      assign item_custom_image_key = 'item_' | append: i | append: '_custom_image'

      assign item_enabled = block.settings[item_enabled_key]
      assign item_collection = block.settings[item_collection_key]
      assign item_custom_title = block.settings[item_custom_title_key]
      assign item_custom_image = block.settings[item_custom_image_key]
    %}

    {% if item_enabled and item_collection != blank %}
      <a href="{{ item_collection.url }}" class="ai-collection-grid-item-{{ ai_gen_id }}"><div class="ai-collection-grid-image-{{ ai_gen_id }}">
          {% if item_custom_image != blank %}
            <img
                src="{{ item_custom_image | image_url: width: 600, height: 600 }}"
                alt="{{ item_custom_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="600"
                style="border-radius: 50%; object-fit: cover; aspect-ratio: 1 / 1;"
              >
          {% elsif item_collection.featured_image != blank %}
            <img
              src="{{ item_collection.featured_image | image_url: width: 600, height: 600 }}"
              alt="{{ item_collection.featured_image.alt | escape }}"
              loading="lazy"
              width="{{ item_collection.featured_image.width }}"
              height="{{ item_collection.featured_image.height }}"
              style="border-radius: 9999px;"
            >
          {% else %}
            <div class="ai-collection-grid-image-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% assign display_title = item_custom_title | default: item_collection.title %}
          {% if display_title != blank %}
            <div class="ai-collection-grid-overlay-{{ ai_gen_id }}">
              <h3 class="ai-collection-grid-overlay-text-{{ ai_gen_id }}">{{ display_title }}</h3>
            </div>
          {% endif %}
        </div>
      </a>
    {% endif %}
  {% endfor %}
</div>

