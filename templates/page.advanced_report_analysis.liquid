    function reduceToSingleDigit(num) {
        while (num > 9 && num !== 11 && num !== 22) {
            num = num
                .toString()
                .split("")
                .reduce((sum, digit) => sum + parseInt(digit, 10), 0);
        }
        return num;
    }

    function getQueryParams() {
        const params = new URLSearchParams(window.location.search);
        return {
            dob: params.get('dob'),
            gender: params.get('gender')
        };
    }

    function calculateLoShuData(dobStr, gender) {
        // Step 1: Extract and sum digits from DOB
        const digits = dobStr.replaceAll("-", "").split("").map(Number);
        const day = parseInt(dobStr.split("-")[2]);
        const total = digits.reduce((sum, d) => sum + d, 0);

        // Step 2: Calculate Driver, Conductor, and Kua
        const driver = reduceToSingleDigit(day);
        const conductor = reduceToSingleDigit(total);

        const year = parseInt(dobStr.split("-")[0]);
        let sumYear = reduceToSingleDigit(year.toString().split("").reduce((acc, digit) => acc + parseInt(digit), 0));

        let kua;
        if (gender === "male") {
            kua = 11 - sumYear;
            if (kua === 5) kua = 2;
        } else {
            kua = sumYear + 4;
            if (kua === 5) kua = 8;
        }
        if (kua > 9) kua = reduceToSingleDigit(kua);

        // Step 3: Count how many times each number from 1 to 9 appears
        const allDigits = [...digits]; // Only digits from DOB
        const numberCounts = {};
        for (let i = 1; i <= 9; i++) numberCounts[i] = 0;
        allDigits.forEach(d => {
            if (d !== 0) numberCounts[d]++;
        });

        const presentNumbers = [];
        const missingNumbers = [];

        for (let i = 1; i <= 9; i++) {
            if (numberCounts[i] > 0) presentNumbers.push(i);
            else missingNumbers.push(i);
        }

        return {
            dobStr,
            driver,
            conductor,
            kua,
            numberCounts,
            presentNumbers,
            missingNumbers
        };
    }

