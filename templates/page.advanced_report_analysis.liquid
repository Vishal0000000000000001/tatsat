            .then(res => res.json())
            .then(data => {
                const products = data.products.filter(p =>
                    p.tags.some(t => tags.includes(t.toLowerCase()))
                );

                if (products.length === 0) {
                    productGrid.innerHTML = "<p>No matching products found.</p>";
                } else {
                    products.forEach(p => {
                        const image = p.images?.[0]?.src || "https://via.placeholder.com/300";
                        const price = p.variants?.[0]?.price || "—";
                        productGrid.innerHTML += `
                            <a href="/products/${p.handle}" class="product-card">
                                <img src="${image}" alt="${p.title}" class="product-image">
                                <div class="product-info">
                                    <div class="product-title">${p.title}</div>
                                    <div class="product-price">Rs${parseFloat(price).toFixed(2)}</div>
                                </div>
                            </a>
                        `;
                    });
                }
                document.getElementById("products").classList.remove("hidden");
            });
    }

    function toggleGrid() {
        const grid = document.getElementById("loShuGridContent");
        if (grid) {
            grid.classList.toggle("mobile-single");
        }
    }


    function submitDOB(dob, gender) {
        setTimeout(() => {
            const data = calculateLoShuData(dob, gender);
            renderMasterReport(data);
            renderLoShuGrid(data);
            renderKuaInfo(data);
            renderDetailedInsights(data);
            const tags = data.missingNumbers.map(n => `number-${n}`);
            renderProducts(tags);
            document.getElementById("result").classList.remove("hidden");
        }, 1500);
    }

    document.addEventListener("DOMContentLoaded", async () => {
        showLoader();

        const { dob, gender } = getQueryParams();
        if (dob && gender) {
            submitDOB(dob, gender);
        }

        // wait for 2 seconds before moving on
        await new Promise(resolve => setTimeout(resolve, 1500));

        document.getElementById("result").classList.remove("hidden");
        document.getElementById("products").classList.remove("hidden");
        hideLoader();
    });
</script>

<script>
    document.getElementById("download-pdf").addEventListener("click", () => {
      const element = document.getElementById("result"); // full page
      const opt = {
        margin:       0,
        filename:     'page.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true },
        jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
      };
      html2pdf().set(opt).from(element).save();
    });
</script>

