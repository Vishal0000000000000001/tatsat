<section>
  <img src="https://cdn.shopify.com/s/files/1/0935/1997/0578/files/Crystal_Guidance_c71dee7d-9dd7-4e2e-9026-6c6ec776508c.jpg?v=1767870818" width="100%". height="auto" > 
</section>
<div id="chakra-section" class="chakra-wrapper">
  <div id="step-1" class="chakra-card fade-in">
    <h2 class="title">Crystal Guidance</h2>
    <p class="subtitle">Enter your Date of Birth and know your missing No. crystals as per your LoShu Grid chart </p>

    {% comment %} <div class="step-heading">Step 1: Choose Your Analysis Type</div>
    <p class="step-description">
      Select whether you'd like a reading based on your date of birth or current life challenges.
    </p> {% endcomment %}

    <div class="option-group">
      <button class="option-btn selected" type="button" onclick="selectMethod('dob')">
        <strong>Date of Birth</strong>
      </button>
      {% comment %} <button class="option-btn" type="button" onclick="selectMethod('category')">
        <strong>Current Problems</strong>
        <span>Receive guidance for specific challenges you’re facing.</span>
      </button> {% endcomment %}
    </div>

    <div class="input-group" id="dob-input">
      <label for="dob">Enter Your Date of Birth</label>
      {% comment %} <input type="date" id="dob" max="{{ 'now' | date: '%Y-%m-%d' }}"> {% endcomment %}
      <input
        placeholder="Date of Birth"
        class="textbox-n"
        type="text"
        onfocus="(this.type='date')"
        onblur="(this.type='text')"
        id="dob"
      >

      <label for="gender">Gender</label>
      <select id="gender">
        <option value="" disabled selected>Select Gender</option>
        <option value="male">Male</option>
        <option value="female">Female</option>
      </select>
      <button class="next-btn" type="button" onclick="submitDOB()">Know your Crystal</button>
    </div>

    <div class="input-group  hidden" id="category-input">
      <label for="category">Select your concern:</label>
      <select id="category">
        <option disabled selected>Select a concern</option>
        <option>Love</option>
        <option>Money</option>
        <option>Education</option>
        <option>Networking</option>
        <option>Evil Eye</option>
        <option>Anti-Aging</option>
        <option>Anti-stress</option>
        <option>Confidence & Leadership</option>
        <option>Emotional Balance & Intuition</option>
        <option>Good Luck & Fortune</option>
        <option>Peace & Clarity</option>
        <option>Success & Progress</option>
        <option>Luxury & Comfort</option>
        <option>Spirituality & Meditation</option>
        <option>Discipline & Success</option>
        <option>Strength & Stamina</option>
      </select>
      <button class="next-btn" type="button" onclick="submitCategory()">Know your Crystal</button>
    </div>
  </div>

  <div id="loading" class="chakra-card hidden fade-in">
    <div class="progress-container"><div class="progress-bar" id="progress-bar"></div></div>
    <p id="thought-message" class="thought-message" aria-live="polite">Aligning your energy...</p>
  </div>

  <div id="result" class="chakra-card hidden fade-in">
    <div class="flex-container hidden">
      <button id="analysisLink" class="next-btn adv-btn hidden" type="button">
        Pay only 499/- and Get Advanced Detailed Analysis
      </button>
    </div>
    <div id="chakra-output"></div>
    <h2 id="grid-heading">Your Lo Shu Grid Chart</h2>
    <div id="loShuGrid"></div>
    <div id="kua-section" style="margin-top: 30px;"></div>
  </div>

  <div id="products" class="chakra-card hidden fade-in">
    <div class="w-100 d-md-flex justify-content-between pt-50">
      <h3>Crystals missing in your Chart</h3>
      <!-- Bulk actions row -->
      <div id="bulk-actions" class="bulk-actions hidden">
        <button id="addAllBtn" class="next-btn bulk-btn" type="button" onclick="addAllToCart()">
          Add All Missing Bracelets to Cart
        </button>
        <span id="addAllNote" class="bulk-note hidden"></span>
      </div>
    </div>

    <div id="product-grid" class="product-grid"></div>
  </div>
</div>

<!-- One-time ALL-OPTIONS bulk chooser -->
<div id="bulkVariantModal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="bvm-title">
  <div class="modal-content" role="document">
    <h3 id="bvm-title">Choose variants for all bracelets</h3>
    <p class="small">
      Pick each option once (e.g., <b>Trinity Healing Rituals</b>, <b>Size</b>). We’ll apply these to all missing
      bracelets.
    </p>

    <div id="bvm-rows"></div>
    <div id="bvm-warning" class="bvm-warning hidden"></div>

    <div class="modal-actions">
      <button type="button" class="next-btn" onclick="confirmBulkVariant()">Apply & Add All</button>
      {% comment %} <button type="button" class="btn-link" onclick="closeBulkModal()">Cancel</button> {% endcomment %}
    </div>
  </div>
  <div class="modal-backdrop" onclick="closeBulkModal()" aria-hidden="true"></div>
</div>

<style>
  .pt-50{padding-top:50px;}
  .chakra-wrapper { font-family: 'Lato', sans-serif; padding: 0 20px; font-weight: 300; color: #493002; max-width: 1200px; margin: auto; }
  .chakra-card { margin: 20px auto; border-radius: 12px; }
  .title { font-size: 1.6rem; font-weight: 400; color: #8B631A; text-align: center; margin-bottom: 10px; }
  .subtitle { font-size: 0.95rem; color: #666; margin-bottom: 20px; text-align: center; }
  .step-heading { font-weight: 400; margin-bottom: 8px; font-size: 1.15rem; }
  .step-description { font-size: 0.95rem; margin-bottom: 20px; }
  .option-group { display: flex; gap: 10px; margin-bottom: 20px; }
  .option-btn { flex: 1; padding: 15px; border: 1px solid #ccc; background: #f9f9f9; cursor: pointer; transition: all 0.3s; color: #493002; display: flex; flex-direction: column; align-items: center; }
  .option-btn.selected { border-color: #493002; background: #fff; font-weight: 600; }
  .option-btn span { margin-top: 4px; font-size: 0.85rem; color: #555; }
  .input-group { display: flex; flex-direction: column; gap: 12px; margin-top: 10px; }
  .input-group label { font-weight: 500; color: #493002; }
  .input-group input, .input-group select { padding: 10px; border: 1px solid #ccc; font-size: 1rem; border-radius: 6px; width: 100%; }
  .next-btn { background: #cead80; color: white; text-transform: uppercase; border: none; padding: 12px 20px; font-weight: 400; cursor: pointer; border-radius: 3px; transition: background-color 0.3s ease-in-out; align-self: flex-start; }
  .next-btn:hover { background: #493002; }
  .adv-btn { margin-left: auto; }
  .progress-container { width: 100%; height: 10px; background: #eee; border-radius: 10px; overflow: hidden; margin-bottom: 20px; }
  .progress-bar { width: 100%; height: 100%; background: linear-gradient(90deg, #4ade80, #3b82f6, #a78bfa); animation: loading 2s infinite linear; }
  @keyframes loading { 0% {transform: translateX(-100%);} 100% {transform: translateX(100%);} }
  .thought-message { font-style: italic; text-align: center; color: #666; user-select: none; }
  #chakra-output { font-size: 1.1rem; line-height: 1.6; color: #493002; margin-bottom: 30px; }
  #grid-heading { font-size: 1.2rem; margin-bottom: 20px; color: #493002; }
  #loShuCard { background: #0d122e; color: #f7e099; border: 8px solid transparent; border-image: linear-gradient(to bottom, #d4af37, #f7e099, #d4af37) 1; box-shadow: 0 0 40px rgba(212, 175, 55, 0.4); padding: 20px; text-align: center; margin: 0 auto 30px auto; }
  .lotus-icon { font-size: 2rem; margin-bottom: 10px; }
  .lo-shu-title { font-size: 2.5rem; font-weight: 700; letter-spacing: 2px; margin-bottom: 10px; color: #fff; text-shadow: 0 0 5px rgba(212,175,55,0.6); }
  .lo-shu-subtitle { font-size: 1.2rem; font-weight: 300; margin-bottom: 20px; }
  .lo-shu-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 100px); gap: 6px; border: 3px solid #f7e099; border-radius: 6px; }
  .lo-shu-cell { display: flex; align-items: center; justify-content: center; font-size: 2.6rem; font-weight: bold; box-shadow: 3px 3px 5px #f7e099, -3px -3px 5px #f7e099; color: #fff; user-select: none; }
  .lo-shu-cell.missing { color: #b57200; font-style: italic; opacity: 0.6; }

  #product-grid { display:flex; flex-wrap: wrap; gap: 20px; margin-top: 15px; }
  @media (min-width: 768px) { #product-grid { grid-template-columns: repeat(3, 1fr); } .product-card{ width: 32%; } }
  .product-card { background: #f2f2f2; border: 1px solid; border-radius: 12px; padding: 10px 15px; box-shadow: 0 3px 10px rgb(0 0 0 / 0.1); text-align: center; transition: transform 0.3s ease; cursor: pointer; }
  .product-card:hover { transform: translateY(-5px); }
  .product-image { max-width: 100%; border-radius: 10px; margin-bottom: 12px; object-fit: cover; }
  .product-title { font-weight: 600; font-size: 0.9rem; color: #493002; margin-bottom: 6px; text-transform: uppercase; }
  .product-price { font-size: 1.1rem; font-weight: 400; color: #8B631A; margin-bottom: 12px; }
  .btn-add-to-cart { background: #cead80; color:rgb(255, 255, 255); padding: 10px 20px; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; width: 90%; }
  .btn-add-to-cart:hover { background: #cead80; color:rgb(255, 255, 255); }

  .hidden { display: none; }
  .fade-in { opacity: 0; transform: translateY(10px); animation: fadeIn 0.6s ease-out forwards; }
  @keyframes fadeIn { to { opacity: 1; transform: translateY(0); } }
  .mobile-toggle { display: none; margin: 20px auto; font-size: 1rem; padding: 10px 18px; background: #8B631A; color: white; border: none; border-radius: 8px; cursor: pointer; }
  @media (max-width: 768px) { .quickview-right h2{font-size: 1rem!important;} .mobile-toggle { display: block; } .next-btn{ width:100%; } .option-btn{ align-items:center; } .option-group { flex-direction: column; } }
  @media (max-width: 430px){ .lo-shu-title, .lo-shu-cell{ font-size: 1.5rem } .chakra-card h3{ font-size: 1.4rem; } .product-title{ font-size: 0.8rem; } .product-price { font-size: 0.8rem; } #product-grid{ gap: 10px; } .product-card{ width: 48.5%; } }
  @media(max-width : 360px){
    .quickview-box{ right: -7px!important;}
    .quickview-right {height: 284px!important; padding: 15px 10px 30px!important;}
    .btn-add-to-cart {font-size: 93%;}
    #product-grid { gap: 8px;}
    .product-card { margin-bottom: 6px; }
    .quickview-close { position: absolute; top: -2px!important; right: 9px!important; }
    .closeBtn { right: 23px!important; }
    
  }

  .bulk-actions{ display:flex; align-items:center; gap:14px; }
  .bulk-btn{ background:#ceac80; }
  .bulk-btn:hover{ background:#8B631A; }
  .bulk-note{ font-size:.9rem; color:#666; }

  /* Modal */
  .modal { position: fixed; inset: 0; display: none; z-index: 9999; }
  .modal:not(.hidden){ display:block; }
  .modal-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.35); }
  .modal-content {
    position: relative; z-index: 9999; max-width: 400px; margin: 8vh auto; background:#fff; border-radius: 16px;
    padding: 20px 20px 16px; box-shadow: 0 20px 60px rgba(0,0,0,.2); color:#1f2937;
  }
  .modal-content h3 { margin:0 0 6px; font-weight:600; }
  .modal-content .small { margin:0 0 14px; color:#6b7280; font-size:.92rem; }
  .modal-row { display:flex; flex-direction:column; gap:6px; margin:10px 0; }
  .modal-row label { font-weight:600; color:#493002; }
  .modal-row select { padding:10px; border:1px solid #d1d5db; border-radius:8px; font-size:1rem; background:#fafafa; }
  .bvm-warning { margin-top:8px; font-size:.9rem; color:#9a6700; background:#fff8e1; border:1px solid #ffecb5; padding:8px 10px; border-radius:8px; }
  .modal-actions { display:flex; align-items:center; gap:12px; margin-top:12px; }
  .btn-link { background:none; border:none; color:#374151; text-decoration:underline; cursor:pointer; padding:8px 10px; }
</style>

<script>
  /* ---------- Loader thoughts ---------- */
  const thoughts = [
    'Aligning your aura...',
    'Calibrating chakras...',
    'Consulting ancient scrolls...',
    'Gathering cosmic data...',
    'Translating soul vibrations...',
    'Syncing with universal energies...',
    'Polishing your destiny crystal...',
  ];
  let thoughtInterval;

  /* ---------- Globals for bulk flow ---------- */
  window._missingNumbers = [];
  window._bulkProducts = []; // full product objects kept for variant mapping

  /* ---------- UI basics ---------- */
  function selectMethod(method) {
    document.querySelectorAll('.option-btn').forEach((btn) => btn.classList.remove('selected'));
    document.getElementById('dob-input').classList.add('hidden');
    document.getElementById('category-input').classList.add('hidden');
    if (method === 'dob') {
      document.getElementById('dob-input').classList.remove('hidden');
      document.querySelectorAll('.option-btn')[0].classList.add('selected');
    } else {
      document.getElementById('category-input').classList.remove('hidden');
      document.querySelectorAll('.option-btn')[1].classList.add('selected');
    }
  }
  function showLoader() {
    document.getElementById('step-1').classList.add('hidden');
    document.getElementById('loading').classList.remove('hidden');
    let index = 0;
    const msg = document.getElementById('thought-message');
    msg.innerText = thoughts[index];
    clearInterval(thoughtInterval);
    thoughtInterval = setInterval(() => {
      index = (index + 1) % thoughts.length;
      msg.innerText = thoughts[index];
    }, 3000);
  }
  function hideLoader() {
    clearInterval(thoughtInterval);
    document.getElementById('loading').classList.add('hidden');
  }

  /* ---------- Numerology helpers ---------- */
  function reduceToSingleDigit(n) {
    n = Number(n) || 0;
    while (n >= 10) {
      n = n
        .toString()
        .split('')
        .reduce((s, d) => s + (parseInt(d, 10) || 0), 0);
    }
    return n;
  }
  function calculateDriver(dobStr) {
    const day = parseInt(dobStr.split('-')[2], 10);
    return reduceToSingleDigit(day);
  }
  function calculateConductor(dobStr) {
    const digits = dobStr
      .replaceAll('-', '')
      .split('')
      .map((d) => parseInt(d, 10) || 0);
    const total = digits.reduce((s, d) => s + d, 0);
    return reduceToSingleDigit(total);
  }
  function calculateKuaNumber(dobStr, gender) {
    const year = parseInt(dobStr.split('-')[0], 10);
    const sum = reduceToSingleDigit(
      year
        .toString()
        .split('')
        .reduce((a, d) => a + (parseInt(d, 10) || 0), 0)
    );
    let kua = gender === 'male' ? 11 - sum : sum + 4;
    if (kua === 5) kua = gender === 'male' ? 2 : 8;
    if (kua > 9) kua = reduceToSingleDigit(kua);
    const traits = {
      1: { element: 'Water', direction: 'North', traits: 'Ambitious, communicator, career-oriented' },
      2: { element: 'Earth', direction: 'Southwest', traits: 'Supportive, nurturing, dependable' },
      3: { element: 'Wood', direction: 'East', traits: 'Creative, optimistic, growth-driven' },
      4: { element: 'Wood', direction: 'Southeast', traits: 'Diplomatic, intuitive, expressive' },
      6: { element: 'Metal', direction: 'Northwest', traits: 'Leader, authoritative, protective' },
      7: { element: 'Metal', direction: 'West', traits: 'Joyful, persuasive, charming' },
      8: { element: 'Earth', direction: 'Northeast', traits: 'Stable, wise, disciplined' },
      9: { element: 'Fire', direction: 'South', traits: 'Passionate, visionary, respected' },
    };
    const info = traits[kua] || { element: 'Unknown', direction: 'N/A', traits: 'No traits available.' };
    document.getElementById(
      'kua-section'
    ).innerHTML = `<hr style="margin:30px 0;"><p><strong>Element:</strong> ${info.element}</p><p><strong>Lucky Direction:</strong> ${info.direction}</p><p><strong>Traits:</strong> ${info.traits}</p>`;
    return kua;
  }

  /* ---------- Grid + results ---------- */
  function calculateLoShuGrid(dobStr, kua) {
    const digits = dobStr
      .replaceAll('-', '')
      .split('')
      .map((d) => parseInt(d, 10) || 0);
    const driver = calculateDriver(dobStr);
    const conductor = calculateConductor(dobStr);
    const allDigits = [...digits, driver, conductor];

    const numberCounts = {};
    for (let i = 1; i <= 9; i++) numberCounts[i] = 0;
    allDigits.forEach((d) => {
      if (d !== 0) numberCounts[d]++;
    });

    const presentNumbers = [];
    const missingNumbers = [];
    for (let i = 1; i <= 9; i++) {
      (numberCounts[i] > 0 ? presentNumbers : missingNumbers).push(i);
    }
    window._missingNumbers = missingNumbers.slice();

    const gridOrder = [4, 9, 2, 3, 5, 7, 8, 1, 6];
    const resultContainer = document.getElementById('loShuGrid');
    resultContainer.innerHTML = `
      <div id="loShuCard">
        <div class="lotus-icon">❀</div>
        <div class="lo-shu-subtitle">TAT SAT</div>
        <h2 class="lo-shu-title">LO SHU GRID</h2>
        <div class="lo-shu-subtitle">${new Date(dobStr).toLocaleDateString('en-US', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        })}</div>
        <div class="lo-shu-grid" id="loShuGridContent"></div>
      </div>`;
    const gc = document.getElementById('loShuGridContent');
    gc.innerHTML = '';
    gridOrder.forEach((num) => {
      const count = numberCounts[num];
      const cls = count === 0 ? 'lo-shu-cell missing' : 'lo-shu-cell';
      gc.insertAdjacentHTML('beforeend', `<div class="${cls}">${count === 0 ? '—' : num}</div>`);
    });

    document.getElementById('chakra-output').innerHTML = `
      <div id="basic-info">
        <p>DRIVER: <span style="font-size:1.4rem;">${driver}</span></p>
        <p>CONDUCTOR: <span style="font-size:1.4rem;">${conductor}</span></p>
        <p>PRESENT NUMBERS: ${presentNumbers.join(', ')}</p>
        <p>MISSING NUMBERS: ${missingNumbers.length ? missingNumbers.join(', ') : 'None 🎉'}</p>
      </div>
      <div id="detailed-report-container" style="display:none;"></div>`;

    document.getElementById('analysisLink')?.classList.remove('hidden');
    generateDetailedReport(numberCounts, presentNumbers, missingNumbers, driver, conductor, kua);

    const tags = missingNumbers.map((n) => `number-${n}`);
    renderProducts(tags, null, true);
  }

  function generateDetailedReport(numberCounts, presentNumbers, missingNumbers, driver, conductor, kua) {
    const meanings = {
      1: {
        title: '1 — Will & Leadership',
        lack: 'Boost self-initiative and clarity of goals.',
        tip: "Affirm: 'I lead with calm confidence.'",
      },
      2: {
        title: '2 — Cooperation & Sensitivity',
        lack: 'Work on harmony and emotional balance.',
        tip: 'Practice gentle listening for 5 minutes daily.',
      },
      3: {
        title: '3 — Expression & Joy',
        lack: 'Open your voice; express ideas freely.',
        tip: 'Journal 3 lines every morning.',
      },
      4: {
        title: '4 — Order & Discipline',
        lack: 'Create structures—routines, checklists.',
        tip: 'Schedule a 20-minute daily focus sprint.',
      },
      5: {
        title: '5 — Change & Magnetism',
        lack: 'Invite healthy novelty & adaptability.',
        tip: 'Try one new micro-habit this week.',
      },
      6: {
        title: '6 — Love & Responsibility',
        lack: 'Nurture home, family, and self-care.',
        tip: '10 minutes of conscious gratitude at night.',
      },
      7: {
        title: '7 — Intellect & Intuition',
        lack: 'Balance logic with reflection.',
        tip: 'Read 10 pages or meditate 7 minutes daily.',
      },
      8: { title: '8 — Power & Wealth', lack: 'Align ambition with integrity.', tip: 'Track expenses/income weekly.' },
      9: { title: '9 — Vision & Service', lack: 'Connect to purpose and compassion.', tip: 'One kind act every day.' },
    };
    const presentHtml = presentNumbers
      .map((n) => `<li><strong>${meanings[n].title}</strong> — Balanced potential active.</li>`)
      .join('');
    const missingHtml = missingNumbers
      .map(
        (n) =>
          `<li><strong>${meanings[n].title}</strong><br/><em>Gap:</em> ${meanings[n].lack}<br/><em>Do this:</em> ${meanings[n].tip}</li>`
      )
      .join('');
    const kuaNote = kua ? `<p><strong>Kua ${kua}</strong>: Sit/face your lucky direction for focus sessions.</p>` : '';
    document.getElementById('detailed-report-container').innerHTML = `<div class="detailed-report">
        <h3 style="margin:20px 0 10px;">Your Energy Map</h3>
        <p><strong>Driver ${driver}</strong> is your core impulse; <strong>Conductor ${conductor}</strong> is your operating field.</p>
        ${kuaNote}
        <h4>Strength Lines (Present Numbers)</h4><ul>${
          presentHtml || '<li>No strong repeats—gentle, balanced field.</li>'
        }</ul>
        <h4>Growth Lines (Missing Numbers)</h4><ul>${missingHtml || '<li>None—beautifully complete spread!</li>'}</ul>
      </div>`;
  }

  /* ---------- Products & bulk ---------- */
  function renderProducts(tags, onDone, showBulk = false) {
    const tagsArray = Array.isArray(tags) ? tags.map((t) => String(t).toLowerCase()) : [String(tags).toLowerCase()];
    const grid = document.getElementById('product-grid');
    const bulkRow = document.getElementById('bulk-actions');
    const note = document.getElementById('addAllNote');

    if (showBulk) {
      window._bulkProducts = [];
      bulkRow?.classList.add('hidden');
      if (note) note.textContent = '';
    }

    fetch('/collections/bracelets/products.json')
      .then((r) => {
        if (!r.ok) throw new Error('Failed to fetch products.');
        return r.json();
      })
      .then((data) => {
        const products = (data.products || []).filter((p) =>
          (p.tags || []).some((t) => tagsArray.includes(String(t).toLowerCase().replace(/\s+/g, '-')))
        );
        grid.innerHTML = '';
        if (!products.length) {
          grid.innerHTML = '<p>No matching products found.</p>';
        } else {
          products.forEach((p) => {
            const img = p.images?.[0]?.src || 'https://via.placeholder.com/600x600?text=Tat+Sat';
            const price = p.variants?.[0]?.price || '—';
            const variantId = p.variants?.[0]?.id || '';
            const handle = p.handle;
            if (showBulk) window._bulkProducts.push(p);
            grid.insertAdjacentHTML(
              'beforeend',
              `
              <div class="product-card" role="button" tabindex="0" onclick="openQuickView('${handle}')" onkeypress="if(event.key==='Enter'){openQuickView('${handle}') }">
                <img src="${img}" alt="${escapeHtml(p.title)}" class="product-image"/>
                <div class="product-title">${escapeHtml(p.title)}</div>
                <div class="product-price">₹ ${Number(price).toFixed(
                  2
                )} <span style="color:#9b9b9b;text-decoration:line-through;">₹ 3999.99</span></div>
                <div class="product-card-price d-block relative">
                  <button class="btn-add-to-cart" type="button" onclick="openQuickView('${handle}')">Add to Cart</button>
                </div>
              </div>`
            );
          });
        }
        document.getElementById('products').classList.remove('hidden');
        if (showBulk && window._bulkProducts.length > 0 && bulkRow) {
          bulkRow.classList.remove('hidden');
          const missNums = (window._missingNumbers || []).join(', ');
          note.textContent = `Ready to add ${window._bulkProducts.length} bracelet${
            window._bulkProducts.length > 1 ? 's' : ''
          } mapped to missing numbers: ${missNums}.`;
        }
      })
      .catch((e) => {
        console.error(e);
        grid.innerHTML = '<p>We’re unable to load products right now. Please try again in a bit.</p>';
      })
      .finally(() => {
        if (typeof onDone === 'function') onDone();
      });
  }

  function escapeHtml(str = '') {
    return String(str).replace(
      /[&<>"']/g,
      (s) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[s])
    );
  }
  function openQuickView(handle) {
    const url = handle ? `/products/${handle}?view=quick` : '/collections/bracelets';
    window.location.href = url;
  }

  /* ---------- Open cart popup/drawer across themes ---------- */
  function openCartPopup() {
    const drawer =
      document.querySelector('cart-drawer') ||
      document.querySelector('.cart-drawer') ||
      document.querySelector('#CartDrawer');
    if (drawer && typeof drawer.open === 'function') {
      drawer.open();
      return;
    }
    document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
    document.body.dispatchEvent(new CustomEvent('theme:cart:open', { bubbles: true }));
    document.body.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
    const toggle =
      document.querySelector('[data-cart-toggle]') ||
      document.querySelector('.js-drawer-open-cart') ||
      document.querySelector('[data-action="open-drawer"][data-drawer-id="cart"]') ||
      document.querySelector('button[aria-controls="CartDrawer"]') ||
      document.querySelector('a[href="/cart"]');
    if (toggle) {
      toggle.click();
      return;
    }
    window.location.href = '/cart';
  }

  function addToCart(variantId) {
    if (!variantId) {
      alert('Unable to add product: Variant not found.');
      return;
    }
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 }),
    })
      .then((r) => {
        if (!r.ok) throw new Error('Failed to add product to cart.');
        return r.json();
      })
      .then(() => {
        openCartPopup();
      })
      .catch((e) => {
        console.error(e);
        alert('Error adding to cart. Please try again.');
      });
  }

  /* ---------- Build ALL-OPTIONS modal ---------- */
  function productHasOption(product, optionName) {
    return (product.options || []).some((o) => (o.name || '').toLowerCase() === String(optionName).toLowerCase());
  }
  function buildUnionValues(products, optionName) {
    const set = new Set();
    products.forEach((p) => {
      const opt = (p.options || []).find((o) => (o.name || '').toLowerCase() === String(optionName).toLowerCase());
      if (opt && Array.isArray(opt.values)) opt.values.forEach((v) => v && set.add(String(v)));
    });
    const order = ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'Small', 'Medium', 'Large'];
    const arr = Array.from(set);
    arr.sort((a, b) => {
      const ai = order.indexOf(a),
        bi = order.indexOf(b);
      if (ai !== -1 || bi !== -1) return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
      const na = parseFloat(a),
        nb = parseFloat(b);
      if (!isNaN(na) && !isNaN(nb)) return na - nb;
      return a.localeCompare(b);
    });
    return arr;
  }
  function getAllOptionNames(products) {
    const freq = new Map();
    products.forEach((p) => {
      (p.options || []).forEach((o) => {
        const n = String(o.name || '').trim();
        if (!n) return;
        const k = n.toLowerCase();
        if (!freq.has(k)) freq.set(k, { name: n, count: 0 });
        freq.get(k).count++;
      });
    });
    const list = Array.from(freq.values());
    const prefer = ['trinity healing rituals', 'healing', 'ritual', 'size', 'wrist size', 'bracelet size', 'length'];
    list.sort((a, b) => {
      const ai = prefer.findIndex((p) => a.name.toLowerCase().includes(p));
      const bi = prefer.findIndex((p) => b.name.toLowerCase().includes(p));
      const as = ai === -1 ? 999 : ai,
        bs = bi === -1 ? 999 : bi;
      if (as !== bs) return as - bs;
      return b.count - a.count;
    });
    return list.map((n) => n.name);
  }
  function computeDefaultValue(optionName, values) {
    const name = optionName.toLowerCase();
    const gender = (document.getElementById('gender')?.value || '').toLowerCase();
    if (name.includes('size')) {
      if (gender === 'male') {
        const i = values.findIndex((v) => /male/i.test(v));
        if (i !== -1) return values[i];
      }
      if (gender === 'female') {
        const i = values.findIndex((v) => /female/i.test(v));
        if (i !== -1) return values[i];
      }
    }
    if (name.includes('trinity') || name.includes('healing')) {
      const pref = ['11 Part Healing', '21 Part Healing', '3 Part Healing'];
      for (const p of pref) {
        const i = values.findIndex((v) => v.toLowerCase() === p.toLowerCase());
        if (i !== -1) return values[i];
      }
    }
    return values[0];
  }

  function openBulkVariantModal_ALL() {
    const products = window._bulkProducts || [];
    if (!products.length) {
      alert('No bracelets detected to add.');
      return;
    }

    const names = getAllOptionNames(products); // e.g., ["Trinity Healing Rituals","Size"]
    const rows = document.getElementById('bvm-rows');
    const warn = document.getElementById('bvm-warning');
    rows.innerHTML = '';

    let warnings = [];
    names.forEach((name) => {
      const values = buildUnionValues(products, name);
      const lacking = products.filter((p) => !productHasOption(p, name)).length;
      if (lacking > 0)
        warnings.push(
          `${lacking} item${lacking > 1 ? 's' : ''} don’t have “${name}” — we’ll use the closest available variant.`
        );
      const defVal = computeDefaultValue(name, values);
      const opts = values
        .map((v) => `<option value="${escapeHtml(v)}"${v === defVal ? ' selected' : ''}>${escapeHtml(v)}</option>`)
        .join('');
      rows.insertAdjacentHTML(
        'beforeend',
        `
        <div class="modal-row">
          <label>${escapeHtml(name)}</label>
          <select class="bvm-select" data-option-name="${escapeHtml(name)}">${opts}</select>
        </div>`
      );
    });

    if (warnings.length) {
      warn.classList.remove('hidden');
      warn.innerHTML = warnings.join('<br>');
    } else {
      warn.classList.add('hidden');
      warn.innerHTML = '';
    }

    document.getElementById('bulkVariantModal').classList.remove('hidden');
  }
  function closeBulkModal() {
    document.getElementById('bulkVariantModal').classList.add('hidden');
  }

  function findBestVariantForSelections(product, selections) {
    const nameToPos = new Map();
    (product.options || []).forEach((o, i) => nameToPos.set((o.name || '').toLowerCase(), i + 1));
    const applicable = Object.entries(selections).filter(([n]) => nameToPos.has(n.toLowerCase()));
    if (!applicable.length) {
      const av = (product.variants || []).find((v) => v.available) || product.variants?.[0];
      return { id: av?.id || null, matched: 0, total: 0 };
    }
    let best = { id: null, matched: -1, available: false };
    (product.variants || []).forEach((v) => {
      let score = 0;
      for (const [n, val] of applicable) {
        const pos = nameToPos.get(n.toLowerCase());
        if (String(v['option' + pos]) === String(val)) score++;
      }
      const better =
        (v.available && !best.available) ||
        (v.available === best.available && score > best.matched) ||
        (v.available === best.available && score === best.matched && best.id === null);
      if (better) best = { id: v.id, matched: score, available: !!v.available };
    });
    if (best.id) return { id: best.id, matched: best.matched, total: applicable.length };
    const av = (product.variants || []).find((v) => v.available) || product.variants?.[0];
    return { id: av?.id || null, matched: 0, total: applicable.length };
  }

  function confirmBulkVariant() {
    const sels = {};
    document.querySelectorAll('.bvm-select').forEach((sel) => {
      sels[sel.dataset.optionName] = sel.value;
    });
    const items = [];
    let fallbackCount = 0;
    (window._bulkProducts || []).forEach((p) => {
      const r = findBestVariantForSelections(p, sels);
      if (!r.id) return;
      if (r.matched < r.total) fallbackCount++;
      items.push({ id: String(r.id), quantity: 1 });
    });
    closeBulkModal();
    bulkAddItems(items, fallbackCount);
  }

  function bulkAddItems(items, fallbackCount = 0) {
    const btn = document.getElementById('addAllBtn');
    const note = document.getElementById('addAllNote');
    if (!items.length) {
      alert('No matching variants found to add.');
      return;
    }
    if (btn) btn.disabled = true;
    if (note) note.textContent = 'Adding all selected bracelets to your cart...';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items }),
    })
      .then((r) => {
        if (!r.ok) throw new Error('Failed to add items to cart.');
        return r.json();
      })
      .then(() => {
        if (note)
          note.textContent = `Added ${items.length} bracelet${items.length > 1 ? 's' : ''} to your cart${
            fallbackCount ? ` (${fallbackCount} used closest option)` : ''
          } ✔`;
        openCartPopup();
      })
      .catch((e) => {
        console.error(e);
        if (note) note.textContent = "We couldn't add everything. Please try again or add individually.";
        alert("Some items couldn't be added. Please try again.");
      })
      .finally(() => {
        if (btn) btn.disabled = false;
      });
  }

  /* ---------- Bulk button: open ALL-OPTIONS modal ---------- */
  function addAllToCart() {
    if (!window._bulkProducts?.length) {
      alert('No bracelets detected to add.');
      return;
    }
    openBulkVariantModal_ALL();
  }

  /* ---------- Submit handlers ---------- */
  function submitDOB() {
    const dob = document.getElementById('dob').value;
    const gender = document.getElementById('gender').value;
    if (!dob) return alert('Please enter your date of birth.');
    if (!gender) return alert('Please select your gender.');
    showLoader();
    setTimeout(() => {
      const kua = calculateKuaNumber(dob, gender);
      calculateLoShuGrid(dob, kua);
      hideLoader();
      document.getElementById('result').classList.remove('hidden');
      document.getElementById('result').scrollIntoView({ behavior: 'smooth' });
    }, 800);
  }
  function submitCategory() {
    const category = document.getElementById('category').value;
    if (!category || category === 'Select a concern') return alert('Please select a category.');
    showLoader();
    renderProducts(
      category.toLowerCase().replaceAll(' ', '-'),
      () => {
        hideLoader();
        document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
      },
      false
    );
  }

  document.getElementById('analysisLink').addEventListener('click', function (e) {
    e.preventDefault();
    const c = document.getElementById('detailed-report-container');
    if (c) {
      c.style.display = 'block';
      c.scrollIntoView({ behavior: 'smooth' });
    }
    addToCart('51562545283346'); // replace with your actual variant ID
  });
</script>
