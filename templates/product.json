    "custom_liquid_3kNNGK": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .custom-tab-section {\n    padding: 40px 20px;\n    max-width: 1000px;\n    margin: 0 auto;\n  }\n\n  .custom-tab-buttons {\n    display: flex;\n    justify-content: center;\n    border-bottom: 2px solid #e5e5e5;\n    margin-bottom: 30px;\n    gap: 10px;\n  }\n\n  .custom-tab-buttons button {\n    flex: 1;\n    max-width: 230px;\n    background: transparent;\n    border: none;\n    padding: 14px 20px;\n    font-size: 15px;\n    font-weight: 600;\n    cursor: pointer;\n    color: #333333;\n    border-bottom: 3px solid transparent;\n    transition: all 0.3s ease;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .custom-tab-buttons button:hover {\n    color: #493002;\n  }\n\n  .custom-tab-buttons button.active {\n    border-bottom-color: #493002;\n    color: #493002;\n  }\n\n  .custom-tab-content {\n    display: none;\n    animation: customFadeIn 0.4s ease-in-out;\n    padding: 20px 30px;\n  }\n\n  .custom-tab-content.active {\n    display: block;\n  }\n\n  .custom-tab-header {\n    font-size: 18px;\n    font-weight: 400;\n    margin-bottom: 15px;\n        color: #4d3508;\n    line-height: 1;\n  }\n\n  .custom-tab-text {\n    font-size: 16px;\n    font-weight: 400;\n        color: #4d3508;\n    line-height: 1.7;\n  }\n\n  .custom-tab-text p {\n    margin-bottom: 12px;\n  }\n\n  .custom-tab-text ul,\n  .custom-tab-text ol {\n    margin: 15px 0;\n    padding-left: 25px;\n  }\n\n  .custom-tab-text li {\n    margin-bottom: 8px;\n  }\n\n  @keyframes customFadeIn {\n    from {\n      opacity: 0;\n      transform: translateY(10px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  /* Mobile accordion style */\n  .custom-accordion-item {\n    border-bottom: 1px solid #e5e5e5;\n    padding: 0;\n  }\n\n  .custom-accordion-header {\n    display: flex;\nwidth:100%;\n    justify-content: space-between;\n    align-items: center;\n    font-weight: 600;\n    font-size: 15px;\n    cursor: pointer;\n    padding: 16px 10px;\n    color: #333333;\n    transition: all 0.3s ease;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .custom-accordion-header:hover {\n    color: #493002;\n  }\n\n  .custom-accordion-header span {\n    font-size: 24px;\n    font-weight: 300;\n    transition: transform 0.3s ease;\n  }\n\n  .custom-accordion-content {\n    display: none;\n    padding: 10px 10px 20px;\n    animation: customFadeIn 0.3s ease-in-out;\n  }\n\n  .custom-accordion-content.open {\n    display: block;\n  }\n\n  /* Toggle between tab and accordion */\n  .custom-desktop-tabs {\n    display: block;\n  }\n\n  .custom-mobile-accordion {\n    display: none;\n  }\n\n  @media (max-width: 768px) {\n    .custom-tab-section {\n      padding: 30px 15px;\n    }\n\n    .custom-desktop-tabs {\n      display: none;\n    }\n\n    .custom-mobile-accordion {\n      display: block;\n    }\n\n    .custom-tab-header {\n      font-size: 20px;\n    }\n\n    .custom-tab-text {\n      font-size: 14px;\n    }\n  }\n</style>\n\n<div class=\"custom-tab-section\">\n  \n  <!-- DESKTOP TABS -->\n  <div class=\"custom-desktop-tabs\">\n    <div class=\"custom-tab-buttons\">\n      <button class=\"custom-tab-btn active\" onclick=\"openCustomTab(event, 'custom-tab-1')\">\n        3 Steps - Basic\n      </button>\n      <button class=\"custom-tab-btn\" onclick=\"openCustomTab(event, 'custom-tab-2')\">\n        11 Steps - Advance \n      </button>\n      <button class=\"custom-tab-btn\" onclick=\"openCustomTab(event, 'custom-tab-3')\">\n       21 Steps - Premium \n      </button>\n    </div>\n\n    <!-- Tab 1 Content -->\n    <div id=\"custom-tab-1\" class=\"custom-tab-content active\">\n      <div class=\"custom-tab-header\">When your home feels calm but you want to invite deeper peace, better sleep, and spiritual protection.</div>\n      <div class=\"custom-tab-text\">\n        \n        <ol>\n          <li>Light Codes – Activate calm and divine connection in your space.s</li>\n          <li>Sound Frequency – Align the room’s vibration with serenity and clarity.</li>\n          <li>Fire Ritual – Seal your intention for a peaceful, protected atmosphere.</li>\n        \n        </ol>\n        <p>Perfect for bedrooms or meditation corners where you want quiet, healing energy.</p>\n      </div>\n    </div>\n\n    <!-- Tab 2 Content -->\n    <div id=\"custom-tab-2\" class=\"custom-tab-content\">\n      <div class=\"custom-tab-header\">When the house feels heavy, or minds stay restless even in silence.</div>\n      <div class=\"custom-tab-text\">\n        <p>Includes all 3 Parts plus 8 deeper layers:</p>\n        <ol>\n          <li>Crown & Third Eye Chakra harmonization for mental clarity.</li>\n          <li>Karmic clearing of stress and emotional tension from the space.</li>\n<li>Calm frequency chanting to soothe the aura.</li>\n<li>Ancestral peace blessing for family harmony.</li>\n<li>Aura and energy grid balancing for smooth flow.</li>\n<li>Air and Water Elemental Cleansing for fresh vibration.</li>\n<li>Moon Sun and Rain Water Healing for renewal.</li>\n<li>Gratitude and peace visualization to anchor stillness.</li>\n\n        </ol>\n        <p>Ideal when your space feels emotionally charged and needs calm, gentle light.</p>\n      </div>\n    </div>\n\n    <!-- Tab 3 Content -->\n    <div id=\"custom-tab-3\" class=\"custom-tab-content\">\n      <div class=\"custom-tab-header\">When energy in the home feels disturbed, anxious, or cluttered.</div>\n      <div class=\"custom-tab-text\">\n        <p>Includes all 3 & 11 Parts plus 10 advanced ceremonies:</p>\n        <ol>\n        <li>Deep karmic space clearing of arguments and mental noise.</li>\n<li>Protection and serenity rituals.</li>\n<li>Timeline correction for repeated stress patterns.</li>\n<li>Planetary harmony for Peace Yog Jupiter and Neptune.</li>\n<li>Light Code infusion through 396 Hz for release and purification.</li>\n<li>Emotional release and home aura renewal therapy.</li>\n<li>Crystal Grid for Peace and Protection.</li>\n<li>Sacred Mirror Ritual for Stillness and Grace.</li>\n<li>Energy portal activation for flow and calm.</li>\n<li>Ancestral Blessing Invocation and Fire sealing for long-term serenity.</li>\n\n        </ol>\n        <p>Ideal when you want your home to radiate quiet, protection, and divine restfulness.</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- MOBILE ACCORDION -->\n  <div class=\"custom-mobile-accordion\">\n    \n    <!-- Accordion 1 -->\n    <div class=\"custom-accordion-item\">\n      <div class=\"custom-accordion-header\" onclick=\"toggleCustomAccordion(this)\">\n        3 Part Healing\n        <span>+</span>\n      </div>\n      <div class=\"custom-accordion-content\">\n       \n        <div class=\"custom-tab-text\">\n       \n         <ol>\n          <li>Light Codes – Activate calm and divine connection in your space.s</li>\n          <li>Sound Frequency – Align the room’s vibration with serenity and clarity.</li>\n          <li>Fire Ritual – Seal your intention for a peaceful, protected atmosphere.</li>\n        \n        </ol>\n        <p>Perfect for bedrooms or meditation corners where you want quiet, healing energy.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Accordion 2 -->\n    <div class=\"custom-accordion-item\">\n      <div class=\"custom-accordion-header\" onclick=\"toggleCustomAccordion(this)\">\n        11 Part Healing\n        <span>+</span>\n      </div>\n      <div class=\"custom-accordion-content\">\n       \n      <div class=\"custom-tab-text\">\n        <p>Includes all 3 Parts plus 8 deeper layers:</p>\n        <ol>\n          <li>Crown & Third Eye Chakra harmonization for mental clarity.</li>\n          <li>Karmic clearing of stress and emotional tension from the space.</li>\n<li>Calm frequency chanting to soothe the aura.</li>\n<li>Ancestral peace blessing for family harmony.</li>\n<li>Aura and energy grid balancing for smooth flow.</li>\n<li>Air and Water Elemental Cleansing for fresh vibration.</li>\n<li>Moon Sun and Rain Water Healing for renewal.</li>\n<li>Gratitude and peace visualization to anchor stillness.</li>\n\n        </ol>\n        <p>Ideal when your space feels emotionally charged and needs calm, gentle light.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Accordion 3 -->\n    <div class=\"custom-accordion-item\">\n      <div class=\"custom-accordion-header\" onclick=\"toggleCustomAccordion(this)\">\n        21 Part Healing\n        <span>+</span>\n      </div>\n      <div class=\"custom-accordion-content\">\n      \n      <div class=\"custom-tab-text\">\n        <p>Includes all 3 & 11 Parts plus 10 advanced ceremonies:</p>\n        <ol>\n        <li>Deep karmic space clearing of arguments and mental noise.</li>\n<li>Protection and serenity rituals.</li>\n<li>Timeline correction for repeated stress patterns.</li>\n<li>Planetary harmony for Peace Yog Jupiter and Neptune.</li>\n<li>Light Code infusion through 396 Hz for release and purification.</li>\n<li>Emotional release and home aura renewal therapy.</li>\n<li>Crystal Grid for Peace and Protection.</li>\n<li>Sacred Mirror Ritual for Stillness and Grace.</li>\n<li>Energy portal activation for flow and calm.</li>\n<li>Ancestral Blessing Invocation and Fire sealing for long-term serenity.</li>\n\n        </ol>\n        <p>Ideal when you want your home to radiate quiet, protection, and divine restfulness.</p>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n</div>\n\n<script>\n  // Desktop tab switching\n  function openCustomTab(evt, tabId) {\n    const contents = document.querySelectorAll('.custom-tab-content');\n    const buttons = document.querySelectorAll('.custom-tab-btn');\n\n    contents.forEach(c => c.classList.remove('active'));\n    buttons.forEach(b => b.classList.remove('active'));\n\n    document.getElementById(tabId).classList.add('active');\n    evt.currentTarget.classList.add('active');\n  }\n\n  // Mobile accordion toggle\n  function toggleCustomAccordion(header) {\n    const content = header.nextElementSibling;\n    const isOpen = content.classList.contains('open');\n\n    // Close all accordions\n    document.querySelectorAll('.custom-accordion-content').forEach(c => c.classList.remove('open'));\n    document.querySelectorAll('.custom-accordion-header span').forEach(s => s.innerText = '+');\n\n    // Open clicked accordion if it was closed\n    if (!isOpen) {\n      content.classList.add('open');\n      header.querySelector('span').innerText = '−';\n    }\n  }\n</script>",
