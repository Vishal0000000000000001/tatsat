l_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"full-width","section_height":"small","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":0,"padding-block-end":0}},"custom_liquid_i3L4GR":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .custom-contact-form-wrapper {\n    max-width: 1200px;\n    margin: 0px auto;\n    padding: 30px 20px;\n    background: #ffffff;\n    position: relative;\n  }\n\n  .contact-form-header {\n    text-align: center;\n    margin-bottom: 30px;\n    position: relative;\n  }\n\n  .contact-form-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: #007bff;\n    color: #ffffff;\n    padding: 8px 16px;\n    border: none;\n    border-radius: 4px;\n    font-size: 14px;\n    font-weight: 500;\n    cursor: pointer;\n    margin-bottom: 15px;\n  }\n\n  .contact-form-btn svg {\n    width: 16px;\n    height: 16px;\n  }\n\n  .contact-form-title {\n    font-size: 24px;\n    font-weight: 600;\n    color: #333333;\n    margin: 0;\n    position: relative;\n    padding-bottom: 15px;\n  }\n\n  .contact-form-title:after {\n    content: '';\n    position: absolute;\n    bottom: 0;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 60px;\n    height: 3px;\n    background: #007bff;\n    border-radius: 2px;\n  }\n\n  .custom-contact-form {\n    width: 100%;\n  }\n\n  .form-row {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n    margin-bottom: 20px;\n  }\n\n  .form-group {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .form-group label {\n    font-size: 14px;\n    font-weight: 500;\n    color: #333333;\n    margin-bottom: 8px;\n  }\n\n  .form-group label .required {\n    color: #ff0000;\n    margin-left: 3px;\n  }\n\n  .form-group input,\n  .form-group textarea {\n    width: 100%;\n    padding: 12px 15px;\n    border: 1px solid #cccccc;\n    border-radius: 4px;\n    font-size: 14px;\n    color: #333333;\n    transition: all 0.3s ease;\n    background: #f9f9f9;\n  }\n\n  .form-group input:focus,\n  .form-group textarea:focus {\n    outline: none;\n    border-color: #007bff;\n    background: #ffffff;\n  }\n\n  .form-group input::placeholder,\n  .form-group textarea::placeholder {\n    color: #999999;\n  }\n\n  .form-group-full {\n    grid-column: 1 \/ -1;\n  }\n\n  .form-group textarea {\n    min-height: 150px;\n    resize: vertical;\n    font-family: inherit;\n  }\n\n  .form-submit-wrapper {\n    text-align: center;\n    margin-top: 25px;\n    position: relative;\n  }\n\n  .form-submit-wrapper:after {\n    content: '';\n    position: absolute;\n    bottom: -10px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 40px;\n    height: 3px;\n    background: #8b7355;\n    border-radius: 2px;\n  }\n\n  .form-submit-btn {\n    background: #81622c;\n    color: #ffffff;\n    padding: 14px 50px;\n    border: none;\n    border-radius: 4px;\n    font-size: 16px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .form-submit-btn:hover {\n    background: #72593f;\n    transform: translateY(-2px);\n    box-shadow: 0 4px 12px rgba(139, 115, 85, 0.3);\n  }\n\n  .form-submit-btn:active {\n    transform: translateY(0);\n  }\n\n  \/* WhatsApp Button *\/\n  .whatsapp-float {\n    position: fixed;\n    bottom: 30px;\n    left: 30px;\n    width: 55px;\n    height: 55px;\n    background: #25d366;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);\n    cursor: pointer;\n    z-index: 1000;\n    transition: all 0.3s ease;\n  }\n\n  .whatsapp-float:hover {\n    transform: scale(1.1);\n    box-shadow: 0 6px 16px rgba(37, 211, 102, 0.5);\n  }\n\n  .whatsapp-float svg {\n    width: 30px;\n    height: 30px;\n    fill: #ffffff;\n  }\n\n  \/* Success\/Error Messages *\/\n  .form-message {\n    padding: 15px;\n    margin-bottom: 20px;\n    border-radius: 4px;\n    font-size: 14px;\n    display: none;\n  }\n\n  .form-message.success {\n    background: #d4edda;\n    color: #155724;\n    border: 1px solid #c3e6cb;\n    display: block;\n  }\n\n  .form-message.error {\n    background: #f8d7da;\n    color: #721c24;\n    border: 1px solid #f5c6cb;\n    display: block;\n  }\n\n  \/* Back to Top Button *\/\n  .back-to-top {\n    position: fixed;\n    bottom: 30px;\n    right: 30px;\n    width: 50px;\n    height: 50px;\n    background: #333333;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    z-index: 1000;\n    transition: all 0.3s ease;\n    opacity: 0.8;\n  }\n\n  .back-to-top:hover {\n    opacity: 1;\n    transform: translateY(-3px);\n  }\n\n  .back-to-top svg {\n    width: 20px;\n    height: 20px;\n    fill: #ffffff;\n  }\n\n  \/* Responsive *\/\n  @media (max-width: 768px) {\n    .custom-contact-form-wrapper {\n      padding: 20px 15px;\n      margin: 20px auto;\n    }\n\n    .form-row {\n      grid-template-columns: 1fr;\n      gap: 15px;\n    }\n\n    .contact-form-title {\n      font-size: 20px;\n    }\n\n    .form-submit-btn {\n      width: 100%;\n      padding: 14px 30px;\n    }\n\n    .whatsapp-float {\n      width: 50px;\n      height: 50px;\n      bottom: 20px;\n      left: 20px;\n    }\n\n    .whatsapp-float svg {\n      width: 26px;\n      height: 26px;\n    }\n\n    .back-to-top {\n      width: 45px;\n      height: 45px;\n      bottom: 20px;\n      right: 20px;\n    }\n  }\n<\/style>\n\n<div class=\"custom-contact-form-wrapper\">\n  \n  <!-- Form Header -->\n  <div class=\"contact-form-header\">\n   \n  <\/div>\n\n  <!-- Success\/Error Message -->\n  <div id=\"form-message\" class=\"form-message\"><\/div>\n\n  <!-- Contact Form -->\n  {% form 'contact' %}\n    {% if form.posted_successfully? %}\n      <div class=\"form-message success\">\n        ✓ Thank you for contacting us! We'll get back to you soon.\n      <\/div>\n    {% endif %}\n\n    {% if form.errors %}\n      <div class=\"form-message error\">\n        ✗ Please fill in all required fields correctly.\n      <\/div>\n    {% endif %}\n\n    <div class=\"custom-contact-form\">\n      \n      <!-- Name, Email, Phone Row -->\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label for=\"contact-name\">\n            Name <span class=\"required\">*<\/span>\n          <\/label>\n          <input \n            type=\"text\" \n            id=\"contact-name\"\n            name=\"contact[name]\" \n            placeholder=\"Your Name\"\n            required\n          >\n        <\/div>\n\n        <div class=\"form-group\">\n          <label for=\"contact-email\">\n            Email <span class=\"required\">*<\/span>\n          <\/label>\n          <input \n            type=\"email\" \n            id=\"contact-email\"\n            name=\"contact[email]\" \n            placeholder=\"Your Email\"\n            required\n          >\n        <\/div>\n\n        <div class=\"form-group\">\n          <label for=\"contact-phone\">\n            Phone <span class=\"required\">*<\/span>\n          <\/label>\n          <input \n            type=\"tel\" \n            id=\"contact-phone\"\n            name=\"contact[phone]\" \n            placeholder=\"Phone Number\"\n            required\n          >\n        <\/div>\n      <\/div>\n\n      <!-- Message Field -->\n      <div class=\"form-group form-group-full\">\n        <label for=\"contact-message\">\n          Message\n        <\/label>\n        <textarea \n          id=\"contact-message\"\n          name=\"contact[body]\" \n          placeholder=\"Your Message\"\n          rows=\"6\"\n        ><\/textarea>\n      <\/div>\n\n      <!-- Submit Button -->\n      <div class=\"form-submit-wrapper\">\n        <button type=\"submit\" class=\"form-submit-btn\">\n          Submit\n        <\/button>\n      <\/div>\n\n    <\/div>\n  {% endform %}\n\n<\/div>\n\n\n<!-- Back to Top Button -->\n\n<\/div>\n\n<script>\n  \/\/ Form validation and enhancement\n  document.addEventListener('DOMContentLoaded', function() {\n    const form = document.querySelector('.custom-contact-form form');\n    \n    if (form) {\n      form.addEventListener('submit', function(e) {\n        const requiredFields = form.querySelectorAll('[required]');\n        let isValid = true;\n        \n        requiredFields.forEach(field => {\n          if (!field.value.trim()) {\n            isValid = false;\n            field.style.borderColor = '#ff0000';\n          } else {\n            field.style.borderColor = '#cccccc';\n          }\n        });\n        \n        if (!isValid) {\n          e.preventDefault();\n          const message = document.getElementById('form-message');\n          message.className = 'form-message error';\n          message.textContent = '✗ Please fill in all required fields.';\n          message.style.display = 'block';\n          \n          \/\/ Scroll to message\n          message.scrollIntoView({ behavior: 'smooth', block: 'center' });\n        }\n      });\n      \n      \/\/ Clear error on input\n      const inputs = form.querySelectorAll('input, textarea');\n      inputs.forEach(input => {\n        input.addEventListener('input', function() {\n          this.style.borderColor = '#cccccc';\n        });\n      });\n    }\n    \n    \/\/ Show\/hide back to top button\n    const backToTop = document.querySelector('.back-to-top');\n    window.addEventL