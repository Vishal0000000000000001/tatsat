style":"solid","gradient_direction":"to top","padding-block-start":0,"padding-block-end":0}},"media_with_content_KbCyw3":{"type":"media-with-content","blocks":{"media":{"type":"_media-without-appearance","static":true,"settings":{"media_type":"image","image":"shopify:\/\/shop_images\/Founders.webp","link":"","video_loop":true,"video_autoplay":false,"image_position":"contain","video_position":"cover"},"blocks":{}},"content":{"type":"_content-without-appearance","static":true,"settings":{"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"space-between","gap":0},"blocks":{"title_VmGpCg":{"type":"title","settings":{"heading_size":"h3","title":"<p>Our Story. Our Dharma.<\/p>","font":"--font-family-second","color":"#8b631a","font_size":30,"line_height":40,"letter_spacing":0,"font_weight":"500","font_style":"normal","align":"center","padding":"","margin":"0 0 20px","color_mobi":"#8b631a","font_size_mobi":25,"line_height_mobi":30,"letter_spacing_mobi":0,"align_mobi":"left"},"blocks":{}},"group_nKL7DQ":{"type":"group","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","custom_height":100,"inherit_color_scheme":true,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"text_mPjgEj":{"type":"text","name":"t:names.text","settings":{"text":"<p>We are Herin & Aakriti Sonawala - soul companions, truth seekers, and firm believers in the eternal law of karma.<br\/>Tat Sat wasn’t built overnight. It was born from a life lived with intention, challenge, grace, and unwavering belief in the power of good deeds.<br\/><br\/>Aakriti lost both her parents at a young age - but their one powerful teaching remained etched in her heart: “Do good, no matter what.” That single seed grew into a way of life. It became her anchor in grief, and her compass on the darkest nights. And it led her to Herin.<br\/><br\/>Herin had already walked the path of seva (selfless service) since childhood. Helping others wasn’t a ritual - it was his nature. He lived each day as a silent prayer, giving wherever he could, expecting nothing in return.<br\/><br\/>When we met, it felt like the universe had brought two karmic frequencies into alignment. Our values mirrored each other, our energies synced - and our mission became clear.<\/p><ul><li>We didn’t just want to create a crystal brand.<\/li><li>We wanted to build a sacred ecosystem.<\/li><li>Where every product supports your soul’s evolution.<\/li><li>Where healing isn’t just given - it’s earned through action, truth, and alignment.<\/li><\/ul><p>Tat Sat - meaning “That is the Ultimate Truth” - is a manifestation of this belief.  A sanctuary where ancient wisdom, modern energy healing, and karmic integrity come together.<br\/><br\/>From surviving hardships to building a haven of healing, the bridge was - and will always be- Good Karma. And that’s what we offer you today. Not just crystals. But divine companions coded with light, love, and truth.<br\/>So you, too, can walk your path with grace, purpose, and a soul aligned with dharma.<br\/><br\/>Tat Sat is not a brand. It's a karmic calling.<br\/><br\/><strong>Hari Om Tat Sat<\/strong><br\/>The Ultimate Truth<\/p>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_mPjgEj"]}},"block_order":["title_VmGpCg","group_nKL7DQ"]}},"name":"t:names.editorial","settings":{"media_position":"right","media_width":"medium","media_height":"60svh","section_width":"page-width","extend_media":false,"color_scheme":"scheme-1","padding-block-start":20,"padding-block-end":0}}},"order":["main","section_mJAYDp","media_with_content_KbCyw3"]}